---
import AutobotInstallLab from '../views/AutobotInstallLab.astro';
import InvincibleInstallLab from '../views/InvincibleInstallLab.astro';
import NotHere from '../views/NotHere.astro';

const key = process.env.SITE_KEY || 'autobot';
---
{key === 'autobot' ? <AutobotInstallLab /> : key === 'invincible' ? <InvincibleInstallLab /> : <NotHere what="Install" />}
