---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import Icon from '../components/Icon.astro';
import { meta, releases, install } from '../data/site';
import { fmtBytes, fmtDate, v } from '../lib/format';
import AutobotInstallLab from '../views/AutobotInstallLab.astro';

const key = process.env.SITE_KEY || 'autobot';
const a = releases.autobot;
const i = releases.invincible;
const latest = key === 'invincible' ? i.latest : a.latest;
const apk = a.latest.assets.find((x) => /release\.apk$/.test(x.name));
const sumsA = a.latest.assets.find((x) => x.name === 'SHA256SUMS.txt');
const apkHash = a.checksums?.split('\n').find((l) => l.includes('release.apk'))?.split(/\s+/)[0];
const cert = '9a1378acf9587885e7920355558c85a1ec0e89304f58c153feebf90fdee7f3f1';
const mac = i.latest.assets.find((x) => /macos/.test(x.name));
const linux = i.latest.assets.find((x) => /linux-x64/.test(x.name));
const sumsI = i.latest.assets.find((x) => x.name === 'SHA256SUMS');
---
{key === 'autobot' ? <AutobotInstallLab /> : (
<Base
  path="/install"
  title="Install"
  description={`Install ${key === 'sovware' ? 'Autobot or Invincible' : meta.name} — requirements, commands, verification and the first run.`}
  og={meta.og}
>
  <header class="page-head">
    <div class="shell">
      <div class="page-head__meta">
        <span class="eyebrow">Install</span>
        <span class="pill pill--red">Latest {v(latest.tag)}</span>
        <span class="pill">{fmtDate(latest.published)}</span>
      </div>
      <h1>
        {key === 'invincible' ? <>One script.<br /><em>A machine that stays on.</em></> : key === 'sovware' ? <>Pick a surface.<br /><em>Keep the rules.</em></> : <>Put it on the phone.<br /><em>Keep the model.</em></>}
      </h1>
      <p class="lede">
        {key === 'invincible'
          ? 'macOS on Apple silicon, or Linux on x86_64 and arm64. No root. The script installs Invincible Gateway and the Autobot Agent, verifies the release, and walks through network, model and background services.'
          : key === 'sovware'
            ? 'Autobot for the phone, Invincible for a machine you own. Both are installed without an account; both can be verified before they run.'
            : 'Android 14+ on arm64, or iOS 18+. The app starts offline with no model installed — that is the point. Add a model when you are ready, from the app or from your own files.'}
      </p>
      <div class="page-head__aside">
        <div>No account</div>
        <div>No analytics</div>
        <div>Signed artifacts</div>
      </div>
    </div>
  </header>

  {key === 'sovware' ? (
    <div class="section">
      <div class="shell">
        <div class="products">
          <a class="product" href="https://autobot.sh/install">
            <div class="product__top"><span class="pill pill--red">v{v(a.latest.tag)}</span><span class="product__index">Phone</span></div>
            <div>
              <h2 class="product__bm">Auto<em>bot</em></h2>
              <p>Android 14+ (arm64) and iOS 18+. Signed APK, TestFlight, and a build-from-source path.</p>
            </div>
            <span class="product__go">Install Autobot <span aria-hidden="true">→</span></span>
          </a>
          <a class="product" href="https://invincible.sh/install">
            <div class="product__top"><span class="pill pill--red">v{v(i.latest.tag)}</span><span class="product__index">Node</span></div>
            <div>
              <h2 class="product__bm">Invin<em>cible</em></h2>
              <p>macOS arm64, Linux x64 or arm64. One script installs the gateway and the Autobot Agent.</p>
            </div>
            <span class="product__go">Install Invincible <span aria-hidden="true">→</span></span>
          </a>
        </div>
        <div class="callout mt-4">
          <div>
            <span class="eyebrow no-rule">The agent</span>
            <h2 class="mt-2">One command.<br />Both halves.</h2>
            <p>The Autobot Agent ships with Invincible Gateway. Install the node and the agent arrives with it.</p>
          </div>
          <div class="callout__actions">
            <a class="btn" href="https://invincible.sh/install">Node install <span class="btn__arrow">↗</span></a>
          </div>
        </div>
      </div>
    </div>
  ) : key === 'invincible' ? (
    <>
      <div class="section">
        <div class="shell">
          <div class="split" data-tabs>
            <div class="split__main">
              <div class="tabs" role="tablist" aria-label="Install options">
                <button class="tab" role="tab" id="tab-script" aria-controls="panel-script" aria-selected="true" tabindex="0" type="button">One script</button>
                <button class="tab" role="tab" id="tab-source" aria-controls="panel-source" aria-selected="false" tabindex="-1" type="button">From source</button>
                <button class="tab" role="tab" id="tab-binary" aria-controls="panel-binary" aria-selected="false" tabindex="-1" type="button">Binaries</button>
              </div>

              <div class="tabpanel" role="tabpanel" id="panel-script" aria-labelledby="tab-script">
                <Terminal
                  title="install · macOS / linux"
                  command="curl -fsSL https://invincible.sh/install.sh | sh"
                  lines={[
                    { kind: 'dim', text: '# no root · verifies the release signature first' },
                    { kind: 'ok', text: '→ invincible + autobot in ~/.local/bin' },
                    { kind: 'ok', text: '→ llama.cpp if missing · pinned build' },
                    { kind: 'ok', text: '→ autobot setup: network · model · agent · Telegram · background' },
                  ]}
                  copyText="curl -fsSL https://invincible.sh/install.sh | sh"
                  note={['Signed by the pinned release key', 'Sigstore attestation when gh is signed in', 'Builds from source without a signed release']}
                />
                <p class="mono mt-3" style="font-size:9px;line-height:1.9;letter-spacing:.09em;color:var(--muted)">
                  Served from this site · SHA-256 {install.sha256} · {fmtBytes(install.bytes)}. The
                  upstream script is at{' '}
                  <a class="link" href="https://raw.githubusercontent.com/wckdboy/invincible/main/install.sh" rel="noopener">github.com/wckdboy/invincible ↗</a>.
                </p>
              </div>

              <div class="tabpanel" role="tabpanel" id="panel-source" aria-labelledby="tab-source" hidden>
                <Terminal
                  title="from source"
                  command="git clone https://github.com/wckdboy/invincible && cd invincible"
                  lines={[
                    { kind: 'dim', text: '# Rust from rustup, and llama-server on PATH' },
                    { kind: 'cmd', text: 'cargo run --release -- serve' },
                    { kind: 'cmd', text: 'cargo run --release -- token' },
                  ]}
                  copyText="git clone https://github.com/wckdboy/invincible && cd invincible\ncargo run --release -- serve"
                  note={['Rust toolchain', 'llama.cpp', 'No runtime']}
                />
              </div>

              <div class="tabpanel" role="tabpanel" id="panel-binary" aria-labelledby="tab-binary" hidden>
                <div class="inset">
                  <span class="eyebrow no-rule">Latest v{v(latest.tag)} · {fmtDate(latest.published)}</span>
                  <p class="section-lede mt-2" style="margin-bottom:1.2rem">
                    Static archives for macOS and Linux. Check them against SHA256SUMS; the script
                    above does this automatically.
                  </p>
                  <div class="release__assets" style="margin-top:0">
                    {i.latest.assets.filter((x) => x.name.endsWith('.tar.gz')).map((x) => (
                      <a class="asset" href={x.url} rel="noopener">
                        <b><Icon name="download" size={11} /></b>
                        {x.name.replace('invincible-', '').replace('.tar.gz', '')}
                        <span>{fmtBytes(x.size)}</span>
                      </a>
                    ))}
                    {sumsI && <a class="asset" href={sumsI.url} rel="noopener"><b>↗</b> SHA256SUMS <span>{fmtBytes(sumsI.size)}</span></a>}
                  </div>
                </div>
              </div>
            </div>

            <div class="split__aside">
              <div class="aside-rule">
                <h3>Before you start</h3>
                <ul class="checklist">
                  <li><b>macOS 13+</b> on Apple silicon, or <b>Linux</b> on x86_64 / arm64.</li>
                  <li><b>curl</b> and <b>git</b>; Rust is installed by rustup only if a source build is needed.</li>
                  <li><b>llama.cpp</b> is installed if missing: Homebrew on macOS, a pinned build on Linux (CUDA when an NVIDIA GPU is present).</li>
                  <li><b>Linux sandboxing</b> for unattended agent work needs <code>bwrap</code> (bubblewrap). Without a sandbox, such commands are refused, not run unconfined.</li>
                </ul>
              </div>
              <div class="note mt-3">
                <b>No root.</b> Everything lives under your home directory, including the binaries,
                models, keys, logs and sessions.
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="section section--rule">
        <div class="shell">
          <div class="section-head">
            <div class="section-head__meta">
              <span class="section-head__num">02</span>
              <span class="eyebrow no-rule">After install</span>
            </div>
            <div>
              <h2>What setup <em>asks you.</em></h2>
              <p>Five questions, in this order. Answer them and the node is running as a background service.</p>
            </div>
          </div>
          <div class="ledger">
            {[
              ['01', 'Network', 'offline, direct, or Tor / SOCKS5 for the whole machine. Cloud backends and the Telegram bot both follow it.'],
              ['02', 'Model', 'a Qwen open-weights model sized to the machine’s memory (Qwen3.5 4B, 9B or 27B), downloaded and checked, or any hf: GGUF.'],
              ['03', 'Agent', 'its working directory, and whether turns stay on local models. The default is yes.'],
              ['04', 'Telegram', 'optionally, a bot token from @BotFather. Approvals arrive as buttons.'],
              ['05', 'Background', 'launchd on macOS; systemd user units with linger on Linux, so it survives logout on a VPS.'],
            ].map(([n, title, body]) => (
              <div class="ledger__row">
                <span class="ledger__n">{n}</span>
                <h3 class="ledger__t">{title}</h3>
                <p class="ledger__d">{body}</p>
              </div>
            ))}
          </div>

          <div class="split mt-4">
            <div class="split__aside">
              <div class="aside-rule">
                <h3>Then</h3>
                <div class="kv"><span>Chat</span><b>autobot</b></div>
                <div class="kv"><span>Code</span><b>autobot code</b></div>
                <div class="kv"><span>One task</span><b>autobot run "…"</b></div>
                <div class="kv"><span>Diagnose</span><b>autobot doctor</b></div>
                <div class="kv"><span>Schedules</span><b>autobot cron add …</b></div>
              </div>
            </div>
            <div class="split__main">
              <Terminal
                title="first run"
                command="autobot"
                lines={[
                  { kind: 'dim', text: '# chat in the terminal, on the node’s models' },
                  { kind: 'cmd', text: 'autobot doctor' },
                  { kind: 'ok', text: 'gateway ✓  model ✓  tools ✓  telegram —  services ✓' },
                ]}
                copyText="autobot doctor"
              />
            </div>
          </div>
        </div>
      </div>

      <div class="section section--rule">
        <div class="shell">
          <div class="section-head">
            <div class="section-head__meta">
              <span class="section-head__num">03</span>
              <span class="eyebrow no-rule">Questions</span>
            </div>
            <div><h2>Before you <em>commit.</em></h2></div>
          </div>
          <div class="faq">
            <details>
              <summary>Is this at version 1?</summary>
              <p>No. v0.x is an early build. It serves models, routes by policy, signs receipts and runs the agent end to end, but the independent security review is still ahead. Treat it as something to try, not as hardened infrastructure.</p>
            </details>
            <details>
              <summary>Does it need an NVIDIA GPU?</summary>
              <p>No. llama.cpp runs on CPU and Apple Metal. A GPU makes larger models pleasant; it is not a requirement for a small one. The installer sizes the default model to the machine.</p>
            </details>
            <details>
              <summary>What is exposed to the network?</summary>
              <p>Loopback and paired interfaces only. Nothing is exposed to the open internet by default. Pairing establishes keys; there is no account or relay. You can put the node behind Tailscale, WireGuard or a Tor onion service if you need it from elsewhere.</p>
            </details>
            <details>
              <summary>Can I still use a cloud model?</summary>
              <p>Yes, if you configure a backend and your rules allow it. It is off by default. Requests go through redaction, are receipted, and are refused when the network is offline or <code>egress = "never"</code>.</p>
            </details>
            <details>
              <summary>How do I verify what I downloaded?</summary>
              <p>The install script checks the archive against a SHA256SUMS file signed by the release key pinned in the script, and checks the Sigstore attestation when the GitHub CLI is signed in. The manual commands are on <a href="/verify">Verify</a>.</p>
            </details>
          </div>
        </div>
      </div>
    </>
  ) : (
    <>
      <div class="section">
        <div class="shell">
          <div class="split" data-tabs>
            <div class="split__main">
              <div class="tabs" role="tablist" aria-label="Install options">
                <button class="tab" role="tab" id="tab-android" aria-controls="panel-android" aria-selected="true" tabindex="0" type="button">Android</button>
                <button class="tab" role="tab" id="tab-ios" aria-controls="panel-ios" aria-selected="false" tabindex="-1" type="button">iOS</button>
                <button class="tab" role="tab" id="tab-agent" aria-controls="panel-agent" aria-selected="false" tabindex="-1" type="button">Autobot Agent</button>
              </div>

              <div class="tabpanel" role="tabpanel" id="panel-android" aria-labelledby="tab-android">
                <h2 class="sr-only">Android installation</h2>
                <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;margin-bottom:14px">
                  <div>
                    <span class="eyebrow no-rule">Signed APK · Android 14+ · arm64</span>
                    <p class="mono" style="margin-top:6px;font-size:13px;letter-spacing:.02em;text-transform:none">{apk?.name}</p>
                  </div>
                  <a class="btn" href={apk?.url} rel="noopener"><Icon name="download" size={13} /> Download</a>
                </div>
                <Terminal
                  title="verify the apk"
                  command={`shasum -a 256 ${apk?.name ?? 'autobot-release.apk'}`}
                  lines={[
                    { kind: 'dim', text: apkHash ? `# expected ${apkHash}` : '# compare with SHA256SUMS.txt' },
                    { kind: 'dim', text: 'apksigner verify --print-certs <apk>' },
                    { kind: 'dim', text: `# signer SHA-256 ${cert.slice(0, 32)}…` },
                  ]}
                  copyText={`shasum -a 256 ${apk?.name ?? 'autobot-release.apk'}`}
                  note={['Signed with autobot-release-2026', 'Certificate pinned in the README', 'SHA256SUMS.txt per release']}
                />
                <h3 class="title-m mt-4" style="font-size:1.5rem">First run</h3>
                <ol class="checklist mt-2">
                  <li><b>Install the APK</b> — allow installs from your browser or file manager when Android asks.</li>
                  <li><b>Open MODELS</b> — the app checks RAM, free storage and CPU features, and marks each model FITS, TIGHT or TOO BIG.</li>
                  <li><b>Download a model</b> — it resumes with HTTP Range and is verified against the hub’s SHA-256. A mismatch deletes the file.</li>
                  <li><b>Stay offline</b> — the network starts Offline. Downloading a model is a visible, switch-off-able request in the Privacy Center.</li>
                  <li><b>Optional</b> — add a cloud provider, then turn on redaction and “phone first” if you want the local model to answer first.</li>
                </ol>
              </div>

              <div class="tabpanel" role="tabpanel" id="panel-ios" aria-labelledby="tab-ios" hidden>
                <p class="lede">
                  TestFlight, under the same app id and version as Android:
                  <code class="inline-code">ai.wckd.autobot</code>. The beta is distributed to
                  testers; the repository documents building it with Xcode.
                </p>
                <div class="hero__actions">
                  <a class="btn btn--ghost" href="https://github.com/wckdboy/autobot/blob/main/ios/README.md" rel="noopener">
                    Build for iPhone <span class="btn__arrow">↗</span>
                  </a>
                  <a class="link" href="/releases">Release history</a>
                </div>
                <div class="inset mt-3">
                  <div class="kv"><span>Bundle ID</span><b>ai.wckd.autobot</b></div>
                  <div class="kv"><span>Version</span><b>{v(a.latest.tag)}</b></div>
                  <div class="kv"><span>Frameworks</span><b>AutobotShared.xcframework</b></div>
                  <div class="kv"><span>Engines</span><b>Metal · Core ML · whisper.cpp</b></div>
                  <div class="kv"><span>Minimum</span><b>iOS 18</b></div>
                </div>
                <p class="mono mt-3" style="font-size:9px;line-height:1.9;letter-spacing:.09em;color:var(--muted)">
                  The iOS app runs the same Kotlin Multiplatform core: the agent runtime, network
                  policy, redaction, settings, models and the .autobot export format.
                </p>
              </div>

              <div class="tabpanel" role="tabpanel" id="panel-agent" aria-labelledby="tab-agent" hidden>
                <p class="lede">
                  The Autobot Agent is the same agent as the phone’s, for a machine that never
                  sleeps. One script installs it next to Invincible Gateway, verifies the release and
                  runs <b>autobot setup</b>. No root.
                </p>
                <Terminal
                  title="install the agent + gateway"
                  command="curl -fsSL https://invincible.sh/install.sh | sh"
                  lines={[
                    { kind: 'dim', text: '# macOS arm64 · Linux x64 / arm64' },
                    { kind: 'ok', text: '→ invincible, autobot → ~/.local/bin' },
                    { kind: 'ok', text: '→ model sized to this machine · llama.cpp if missing' },
                    { kind: 'ok', text: '→ network · agent · Telegram · background services' },
                  ]}
                  copyText="curl -fsSL https://invincible.sh/install.sh | sh"
                  note={['Signed release · pinned key', 'Reproducible Linux builds', 'No account']}
                />
                <div class="hero__actions">
                  <a class="btn btn--ghost" href="https://invincible.sh/install">Node install notes <span class="btn__arrow">↗</span></a>
                  <a class="link" href="/verify">Verify the download</a>
                </div>
              </div>
            </div>

            <div class="split__aside">
              <div class="aside-rule">
                <h3>Requirements</h3>
                <div class="kv"><span>Android</span><b>14+ · arm64</b></div>
                <div class="kv"><span>iOS</span><b>18+ · TestFlight</b></div>
                <div class="kv"><span>Free storage</span><b>Room for a model</b></div>
                <div class="kv"><span>Agent</span><b>macOS arm64 · Linux</b></div>
                <div class="kv"><span>Account</span><b>None</b></div>
                <div class="kv"><span>License</span><b>Apache-2.0</b></div>
              </div>
              <div class="note mt-3">
                <b>No model is bundled.</b> The app opens without one, and says so. Weights are
                large; downloading exactly the model that fits your phone is better than shipping a
                compromise.
              </div>
              <div class="aside-rule mt-3">
                <h3>Source</h3>
                <a class="link" href={meta.repo} rel="noopener">github.com/wckdboy/autobot ↗</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="section section--rule">
        <div class="shell">
          <div class="section-head">
            <div class="section-head__meta">
              <span class="section-head__num">02</span>
              <span class="eyebrow no-rule">Questions</span>
            </div>
            <div><h2>Before you <em>install.</em></h2></div>
          </div>
          <div class="faq">
            <details>
              <summary>Why is the APK 80 MB?</summary>
              <p>It carries the native engines and their libraries for every ARM feature level the app supports, so one APK runs well on old and new phones. Model weights are separate and downloaded on demand.</p>
            </details>
            <details>
              <summary>Will it work on my phone?</summary>
              <p>It needs Android 14 or newer on arm64, or iOS 18. The model manager measures the device and labels each model by fit; a model marked TOO BIG is refused rather than left to swap and stutter.</p>
            </details>
            <details>
              <summary>Does it phone home?</summary>
              <p>No. There is no analytics, crash reporting or update check. Requests happen only when you download a model or add a cloud provider, and every attempt is visible in the Privacy Center.</p>
            </details>
            <details>
              <summary>Can I use it completely offline?</summary>
              <p>Yes. Install a model over the network once, then switch the network mode to Offline. Chat, agents, images, voice and recipes continue on the phone. Loopback models can be allowed or blocked separately.</p>
            </details>
            <details>
              <summary>Where do I check the APK signature?</summary>
              <p>The signing certificate’s SHA-256 is <code>{cert}</code>. The <a href="/verify">Verify</a> page has the exact commands, and every release publishes its own SHA256SUMS.txt.</p>
            </details>
          </div>
        </div>
      </div>
    </>
  )}
</Base>
)}
