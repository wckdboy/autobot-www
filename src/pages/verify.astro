---
import AutobotVerifyLab from '../views/AutobotVerifyLab.astro';
import InvincibleVerifyLab from '../views/InvincibleVerifyLab.astro';
import NotHere from '../views/NotHere.astro';

const key = process.env.SITE_KEY || 'autobot';
---
{key === 'autobot' ? <AutobotVerifyLab /> : key === 'invincible' ? <InvincibleVerifyLab /> : <NotHere what="Verify" />}
