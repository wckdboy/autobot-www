const p = paths[name] || paths.arrow;
const filled = name === 'github' || name === 'apple';
---
<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 14 14"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="1.35"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  set:html={p}
/>
