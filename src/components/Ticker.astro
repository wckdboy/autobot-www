---
interface Props {
  items: string[];
  speed?: number;
}
const { items, speed = 46 } = Astro.props;
const row = [...items, ...items];
---
<div class="ticker" aria-hidden="true">
  <div class="ticker__track" style={`animation-duration:${speed}s`}>
    {[0, 1].map(() => (
      <div class="ticker__group">
        {row.map((item) => <span class="ticker__item">{item}</span>)}
      </div>
    ))}
  </div>
</div>
