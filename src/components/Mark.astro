---
interface Props {
  kind?: 'autobot' | 'invincible' | 'sovware';
  size?: number;
  class?: string;
}
const { kind = 'autobot', size = 28, class: cls = '' } = Astro.props;

// Halftone marks, generated rather than traced.
const dots: { x: number; y: number; r: number; o?: number }[] = [];

if (kind === 'autobot') {
  const n = 17;
  for (let y = 0; y < n; y++) {
    for (let x = 0; x < n; x++) {
      const cx = 4 + x * 1.25;
      const cy = 4 + y * 1.25;
      const t = ((n - 1 - x) + y) / (2 * (n - 1)); // 0 top-right, 1 bottom-left
      const r = 0.16 + t * 0.5;
      dots.push({ x: cx, y: cy, r });
    }
  }
}

if (kind === 'invincible') {
  const n = 17;
  for (let y = 0; y < n; y++) {
    for (let x = 0; x < n; x++) {
      const cx = 4 + x * 1.25;
      const cy = 4 + y * 1.25;
      // inside an upward chevron / delta
      const edge = 14 - Math.abs(cx - 14) * 1.15;
      if (cy > edge - 1.2 && cy < 24) {
        const t = (cy - 3) / 21;
        dots.push({ x: cx, y: cy, r: 0.28 + t * 0.42, o: 0.55 + t * 0.45 });
      }
    }
  }
}

if (kind === 'sovware') {
  for (let y = 0; y < 5; y++) {
    for (let x = 0; x < 5; x++) {
      const inner = x === 2 && y === 2;
      dots.push({
        x: 5.5 + x * 4.25,
        y: 5.5 + y * 4.25,
        r: inner ? 1.5 : 0.85 - Math.max(Math.abs(x - 2), Math.abs(y - 2)) * 0.12,
        o: inner ? 1 : 0.75,
      });
    }
  }
}
---
<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 28 28"
  role="img"
  aria-label={`${kind} mark`}
  xmlns="http://www.w3.org/2000/svg"
>
  {kind === 'autobot' && (
    <>
      <rect width="28" height="28" rx="6" fill="#E8401C" />
      <g fill="#F4EEE6">
        {dots.map((d) => (
          <circle cx={d.x} cy={d.y} r={d.r} />
        ))}
      </g>
    </>
  )}
  {kind === 'invincible' && (
    <>
      <rect width="28" height="28" rx="6" fill="#141414" />
      <g fill="#E8401C">
        {dots.map((d) => (
          <circle cx={d.x} cy={d.y} r={d.r} opacity={d.o} />
        ))}
      </g>
      <circle cx="14" cy="4.6" r="1.5" fill="#F4EEE6" />
    </>
  )}
  {kind === 'sovware' && (
    <>
      <rect width="28" height="28" rx="6" fill="#141414" />
      <g fill="#E8401C">
        {dots.map((d) => (
          <circle cx={d.x} cy={d.y} r={d.r} opacity={d.o} />
        ))}
      </g>
    </>
  )}
</svg>
