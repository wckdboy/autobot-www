---
import Mark from './Mark.astro';
import { meta, releases } from '../data/site';
import { v } from '../lib/format';

const year = 2026;
const built = new Date().toISOString().slice(0, 10).split('-').reverse().join('.');
const latest = meta.key === 'invincible' ? releases.invincible.latest : meta.key === 'autobot' ? releases.autobot.latest : null;
const isProduct = meta.key !== 'sovware';
const repo = isProduct ? meta.repo : 'https://github.com/wckdboy';
---
<footer class="footer">
  <div class="shell">
    <div class="footer__top">
      <div>
        <a class="footer__brand" href="/" aria-label={`${meta.name} home`}>
          <Mark kind={meta.key} size={30} />
          <span class="footer__word">{meta.wordmark}</span>
        </a>
        <p class="footer__tag">{meta.tagline}</p>
        {latest && (
          <p class="footer__tag mono" style="margin-top:1rem;font-size:9px;letter-spacing:.1em">
            Latest v{v(latest.tag)} · {latest.published.slice(0, 10)}
          </p>
        )}
      </div>

      <div class="footer__col">
        <h2 class="footer__col-h">Product</h2>
        <a href="https://autobot.sh">Autobot</a>
        <a href="https://invincible.sh">Invincible</a>
        {isProduct && <a href="/releases">Releases</a>}
        {isProduct && <a href="/install">Install</a>}
      </div>

      <div class="footer__col">
        <h2 class="footer__col-h">Project</h2>
        <a href={repo} rel="noopener">Source code ↗</a>
        {isProduct && <a href={`${repo}/blob/main/ROADMAP.md`} rel="noopener">Roadmap ↗</a>}
        {isProduct && <a href={`${repo}/security`} rel="noopener">Security ↗</a>}
        {isProduct && <a href={`${repo}/blob/main/LICENSE`} rel="noopener">License ↗</a>}
      </div>

      <div class="footer__col">
        <h2 class="footer__col-h">More</h2>
        <a href="https://sovware.io">Sovware</a>
        <a href="https://wckd.ai" rel="noopener">WCKD ↗</a>
        <a href="https://github.com/wckdboy" rel="noopener">GitHub ↗</a>
        <a href="mailto:boy@wckd.cc">Contact</a>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© {year} WCKD · {meta.license}</span>
      <div class="colophon">
        <span>Open source · signed releases</span>
        <span>No analytics · no cookies · no third-party requests</span>
        <span>Set in Antonio &amp; JetBrains Mono</span>
        <span>Built {built}</span>
      </div>
      <a href="#top">Back to top ↑</a>
    </div>
  </div>
</footer>
