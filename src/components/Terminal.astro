---
import Icon from './Icon.astro';

interface Line {
  kind?: 'cmd' | 'out' | 'dim' | 'ok' | 'warn';
  text: string;
}
interface Props {
  title?: string;
  command?: string;
  lines?: Line[];
  prompt?: string;
  copyText?: string;
  copyLabel?: string;
  note?: string[];
}
const {
  title = 'terminal',
  command = '',
  lines = [],
  prompt = '$',
  copyText,
  copyLabel = 'Copy',
  note = [],
} = Astro.props;

const toCopy = copyText ?? command;
const all: Line[] = command ? [{ kind: 'cmd', text: command }, ...lines] : lines;
---
<div class="term">
  <div class="term__bar">
    <span class="term__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="term__title">{title}</span>
    {toCopy && (
      <button class="term__copy" type="button" data-copy={toCopy} aria-label={`Copy: ${toCopy}`}>
        <Icon name="copy" size={11} /> <span data-copy-label>{copyLabel}</span>
      </button>
    )}
  </div>
  <div class="term__body" tabindex="0" role="region" aria-label={`${title} commands`}>
    <div class="term__lines">{all.map((line) => (
      <span class="ln">
        {line.kind === 'cmd' ? (
          <>
            <span class="p">{prompt} </span>
            <span class="cmd">{line.text}</span>
          </>
        ) : (
          <span class={line.kind === 'ok' ? 'g' : line.kind === 'warn' ? 'w' : line.kind === 'dim' ? 'c' : ''}>{line.text}</span>
        )}
      </span>
    ))}</div>
  </div>
</div>
{note.length > 0 && (
  <div class="term-note">
    {note.map((n) => <span>{n}</span>)}
  </div>
)}
