---
import { meta } from '../data/site';
import { kit, symbolSvg } from '../data/kit';
import { NAV } from '../data/nav';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  og?: string;
  brand?: string;
  accent?: string;
  nav?: { label: string; href: string }[];
  current?: string;
  footerNote?: string;
  noindex?: boolean;
}

const {
  title,
  description = meta.description,
  path = Astro.url.pathname,
  og = '/og.png',
  brand = kit.brands[meta.key]?.name ?? 'Autobot',
  accent,
  nav = (NAV as Record<string, { nav: readonly { label: string; href: string }[] }>)[meta.key]?.nav.slice() ?? [
    { label: 'Overview', href: '/' },
    { label: 'Install', href: '/install/' },
    { label: 'Status', href: '/#status' },
    { label: 'Privacy', href: '/privacy/' },
    { label: 'Verify', href: '/verify/' },
    { label: 'Releases', href: '/releases/' },
    { label: 'Source', href: 'https://github.com/wckdboy/autobot' },
  ],
  current = '',
  footerNote = (NAV as Record<string, { footer: string }>)[meta.key]?.footer ?? 'Made by WCKD.',
  noindex = false,
} = Astro.props;

const b = kit.brands[meta.key] ?? kit.brands.autobot;
const accentPaper = accent ?? b.text;
const accentInk = b.onInk;
const canonical = new URL(path, Astro.site).href;
const pageTitle = title ? `${title} — ${brand}` : `${brand} — private AI on the phone`;
const ogImage = new URL(og, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/lab/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/lab.css" />
    <style is:inline set:html={`:root{--accent:${accentPaper};--accent-paper:${accentPaper};--accent-ink:${accentInk};--mark:${b.onPaper};--mark-paper:${b.onPaper};--mark-ink:${b.onInk}}@media (prefers-color-scheme: dark){:root{--accent:${accentInk};--mark:${b.onInk}}}`} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="wrap masthead__in">
        <a class="brand" href="/"><span class="brand__mark" set:html={symbolSvg(b, 14)} />{brand.toLowerCase()} <span class="brand__sub">/ {meta.domain}</span></a>
        <nav class="nav" aria-label="Primary">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={current && item.label.toLowerCase() === current ? 'page' : undefined}
              rel={item.href.startsWith('http') ? 'noopener' : undefined}
            >{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer__in">
        <p>{footerNote}</p>
        <div class="footer__links">
          {(meta.key === 'autobot' || meta.key === 'invincible') && <a href="/releases/">Releases</a>}
          {meta.key === 'autobot' && <a href="/privacy/">Privacy</a>}
          {(meta.key === 'autobot' || meta.key === 'invincible') && <a href="/verify/">Verify</a>}
          <a href="/brand/">Brand</a>
          {meta.key !== 'autobot' && <a href="https://autobot.sh" rel="noopener">Autobot</a>}
          {meta.key !== 'invincible' && <a href="https://invincible.sh" rel="noopener">Invincible</a>}
          {meta.key !== 'wckd' && <a href="https://wckd.ai" rel="noopener">WCKD</a>}
        </div>
      </div>
    </footer>
  </body>
</html>
