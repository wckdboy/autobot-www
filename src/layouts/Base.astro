---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { meta, releases } from '../data/site';
import { v } from '../lib/format';
import '../styles/riso.css';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  og?: string;
  noindex?: boolean;
  bodyClass?: string;
}

const {
  title,
  description = meta.description,
  path,
  og = meta.og,
  noindex = false,
  bodyClass = '',
} = Astro.props;

const pathname = path ?? Astro.url.pathname;
const canonical = new URL(pathname, Astro.site).href;
const pageTitle = title ? `${title} — ${meta.name}` : meta.title;
const ogImage = new URL(og, Astro.site).href;
const latest = meta.key === 'invincible' ? releases.invincible.latest : meta.key === 'autobot' ? releases.autobot.latest : null;

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://sovware.io/#studio',
      name: 'Sovware',
      alternateName: 'WCKD',
      url: 'https://sovware.io',
      sameAs: ['https://github.com/wckdboy', 'https://autobot.sh', 'https://invincible.sh'],
    },
    {
      '@type': 'WebSite',
      '@id': `${meta.origin}/#site`,
      name: meta.name,
      url: meta.origin,
      description,
      publisher: { '@id': 'https://sovware.io/#studio' },
    },
    ...(meta.key === 'autobot'
      ? [
          {
            '@type': 'SoftwareApplication',
            name: 'Autobot',
            applicationCategory: 'ProductivityApplication',
            operatingSystem: 'Android 14+, iOS 18+',
            url: 'https://autobot.sh',
            downloadUrl: latest?.assets.find((a) => /release\.apk$/.test(a.name))?.url,
            softwareVersion: v(latest?.tag),
            license: 'https://www.apache.org/licenses/LICENSE-2.0',
            offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
            description,
          },
        ]
      : meta.key === 'invincible'
        ? [
            {
              '@type': 'SoftwareApplication',
              name: 'Invincible Gateway',
              applicationCategory: 'DeveloperApplication',
              operatingSystem: 'macOS 13+, Linux',
              url: 'https://invincible.sh',
              softwareVersion: v(latest?.tag),
              license: 'https://opensource.org/licenses/MIT',
              offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
              description,
            },
          ]
        : []),
  ],
};
---
<!doctype html>
<html lang="en" class={meta.theme === 'ink' ? 'theme-ink-root' : ''}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="generator" content="Astro" />
    <meta name="color-scheme" content={meta.theme === 'ink' ? 'dark' : 'light'} />
    <meta name="theme-color" content={meta.theme === 'ink' ? '#0e0e0e' : '#efeae2'} />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={meta.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${meta.name} — ${meta.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" href="/fonts/antonio-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  </head>
  <body class={`${meta.theme === 'ink' ? 'theme-ink' : ''} ${bodyClass}`} id="top">
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // ---------------------------------------------------------------- reveal
      const revealed = new WeakSet();
      const reveal = () => {
        const els = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
                revealed.add(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.06 },
        );
        els.forEach((el) => io.observe(el));
      };

      // -------------------------------------------------------------- progress
      const bar = document.getElementById('progress');
      let ticking = false;
      const drawProgress = () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const pct = max > 0 ? Math.min(1, window.scrollY / max) : 0;
        if (bar) bar.style.width = `${(pct * 100).toFixed(2)}%`;
        ticking = false;
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(drawProgress);
          }
        },
        { passive: true },
      );
      drawProgress();

      // ------------------------------------------------------------------ copy
      const writeClipboard = async (text) => {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          const ok = document.execCommand('copy');
          ta.remove();
          return ok;
        }
      };
      document.addEventListener('click', async (event) => {
        const btn = event.target.closest('[data-copy]');
        if (!btn) return;
        const text = btn.getAttribute('data-copy') || '';
        const ok = await writeClipboard(text);
        const label = btn.querySelector('[data-copy-label]');
        const was = label ? label.textContent : '';
        if (label) label.textContent = ok ? 'Copied' : 'Select';
        btn.setAttribute('data-copied', String(ok));
        window.setTimeout(() => {
          if (label) label.textContent = was || 'Copy';
          btn.setAttribute('data-copied', 'false');
        }, 1800);
      });

      // ------------------------------------------------------------------ tabs
      document.querySelectorAll('[data-tabs]').forEach((root) => {
        const tabs = [...root.querySelectorAll('[role="tab"]')];
        const panels = [...root.querySelectorAll('[role="tabpanel"]')];
        const select = (idx, focus = false) => {
          tabs.forEach((tab, i) => {
            const on = i === idx;
            tab.setAttribute('aria-selected', String(on));
            tab.setAttribute('tabindex', on ? '0' : '-1');
            panels[i]?.toggleAttribute('hidden', !on);
            if (on && focus) tab.focus();
          });
        };
        tabs.forEach((tab, i) => {
          tab.addEventListener('click', () => select(i));
          tab.addEventListener('keydown', (e) => {
            if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft' && e.key !== 'Home' && e.key !== 'End') return;
            e.preventDefault();
            const next =
              e.key === 'Home'
                ? 0
                : e.key === 'End'
                  ? tabs.length - 1
                  : (i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
            select(next, true);
          });
        });
      });

      // -------------------------------------------------------------- halftone
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const canvases = [...document.querySelectorAll('canvas[data-halftone]')];
      const states = new Map();
      const clamp = (n, min = 0, max = 1) => Math.min(max, Math.max(min, n));
      const ease = (t) => t * t * (3 - 2 * t);

      function colors(canvas) {
        const cs = getComputedStyle(canvas);
        const pick = (name, fallback) => cs.getPropertyValue(name).trim() || fallback;
        return {
          fg: pick('--fg', '#121211'),
          red: pick('--red', '#e8401c'),
          bg: pick('--bg', '#efeae2'),
          rule: pick('--rule', '#cec6b9'),
        };
      }

      function setup(canvas) {
        const kind = canvas.dataset.halftone || 'field';
        const seed = Number(canvas.dataset.seed || 0);
        const state = { kind, seed, w: 0, h: 0, dpr: 1, visible: true, phase: 0, pointer: { x: 0.5, y: 0.5 } };
        states.set(canvas, state);
        const resize = () => {
          const rect = canvas.getBoundingClientRect();
          if (!rect.width || !rect.height) return;
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          state.w = rect.width;
          state.h = rect.height;
          state.dpr = dpr;
          canvas.width = Math.round(rect.width * dpr);
          canvas.height = Math.round(rect.height * dpr);
          render(canvas, state, true);
        };
        resize();
        if ('ResizeObserver' in window) new ResizeObserver(resize).observe(canvas);
        if ('IntersectionObserver' in window) {
          new IntersectionObserver(
            (entries) => {
              for (const entry of entries) state.visible = entry.isIntersecting;
            },
            { rootMargin: '120px' },
          ).observe(canvas);
        }
        canvas.addEventListener('pointermove', (e) => {
          const rect = canvas.getBoundingClientRect();
          state.pointer.x = (e.clientX - rect.left) / rect.width;
          state.pointer.y = (e.clientY - rect.top) / rect.height;
        });
        canvas.addEventListener('pointerleave', () => {
          state.pointer.x = 0.5;
          state.pointer.y = 0.5;
        });
      }

      function render(canvas, state, still = false) {
        const { ctx } = { ctx: canvas.getContext('2d') };
        if (!ctx || !state.w) return;
        const { w, h, dpr, kind, seed } = state;
        const c = colors(canvas);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, w, h);
        const t = state.phase;
        const short = Math.min(w, h);

        if (kind === 'optic' || kind === 'orb') {
          const cx = w / 2 + (state.pointer.x - 0.5) * w * 0.035;
          const cy = h / 2 + (state.pointer.y - 0.5) * h * 0.035;
          const R = short * 0.43;
          const cell = Math.max(6, short / 42);
          // press grid
          ctx.strokeStyle = c.rule;
          ctx.globalAlpha = 0.5;
          ctx.lineWidth = 1;
          for (let x = cell; x < w; x += cell * 4) {
            ctx.beginPath();
            ctx.moveTo(x, 0);
            ctx.lineTo(x, h);
            ctx.stroke();
          }
          for (let y = cell; y < h; y += cell * 4) {
            ctx.beginPath();
            ctx.moveTo(0, y);
            ctx.lineTo(w, y);
            ctx.stroke();
          }
          ctx.globalAlpha = 1;
          // halftone field
          for (let y = cell * 0.75; y < h; y += cell) {
            for (let x = cell * 0.75; x < w; x += cell) {
              const dx = x - cx;
              const dy = y - cy;
              const dist = Math.hypot(dx, dy);
              const rho = dist / R;
              if (rho > 1.28) continue;
              const ring = 0.5 + 0.5 * Math.sin(dist * 0.055 - t * 1.1);
              const fall = 1 - ease(clamp((rho - 0.2) / 1.05));
              const angle = Math.atan2(dy, dx);
              const sweep = 0.5 + 0.5 * Math.cos(angle * 2 - t * 0.4);
              const f = clamp(fall * (0.38 + 0.62 * ring) + sweep * 0.1);
              if (f < 0.02) continue;
              const radius = cell * 0.56 * f + 0.25;
              const accent = ring > 0.93 && rho < 0.92;
              ctx.fillStyle = accent ? c.red : c.fg;
              ctx.globalAlpha = accent ? 0.95 : 0.22 + f * 0.72;
              ctx.beginPath();
              ctx.arc(x, y, radius, 0, Math.PI * 2);
              ctx.fill();
            }
          }
          ctx.globalAlpha = 1;
          // registration rings
          ctx.strokeStyle = c.fg;
          ctx.lineWidth = 1;
          ctx.globalAlpha = 0.7;
          ctx.beginPath();
          ctx.arc(cx, cy, R * 0.94, 0, Math.PI * 2);
          ctx.stroke();
          ctx.globalAlpha = 0.35;
          ctx.beginPath();
          ctx.arc(cx, cy, R * 1.16, 0, Math.PI * 2);
          ctx.stroke();
          // crosshair
          ctx.globalAlpha = 0.65;
          ctx.beginPath();
          ctx.moveTo(cx - R * 1.3, cy);
          ctx.lineTo(cx - R * 1.08, cy);
          ctx.moveTo(cx + R * 1.08, cy);
          ctx.lineTo(cx + R * 1.3, cy);
          ctx.moveTo(cx, cy - R * 1.3);
          ctx.lineTo(cx, cy - R * 1.08);
          ctx.moveTo(cx, cy + R * 1.08);
          ctx.lineTo(cx, cy + R * 1.3);
          ctx.stroke();
          // red pupil and tick
          ctx.fillStyle = c.red;
          ctx.globalAlpha = 0.92;
          ctx.beginPath();
          ctx.arc(cx, cy, Math.max(3, cell * 0.42), 0, Math.PI * 2);
          ctx.fill();
          ctx.globalAlpha = 1;
          // sweep hand
          const a = -Math.PI / 2 + t * 0.55;
          ctx.strokeStyle = c.red;
          ctx.globalAlpha = 0.55;
          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.lineTo(cx + Math.cos(a) * R * 0.9, cy + Math.sin(a) * R * 0.9);
          ctx.stroke();
          ctx.globalAlpha = 1;
        }

        if (kind === 'globe') {
          const cx = w / 2;
          const cy = h / 2;
          const R = short * 0.36;
          const cell = Math.max(6, short / 44);
          // sphere shading in dots
          for (let y = cy - R; y <= cy + R; y += cell) {
            for (let x = cx - R; x <= cx + R; x += cell) {
              const dx = (x - cx) / R;
              const dy = (y - cy) / R;
              const rr = dx * dx + dy * dy;
              if (rr > 1) continue;
              const z = Math.sqrt(1 - rr);
              const lx = -0.42;
              const ly = -0.55;
              const lz = 0.72;
              const shade = clamp(dx * lx + dy * ly + z * lz);
              const edge = 1 - ease(clamp((Math.sqrt(rr) - 0.82) / 0.2));
              const f = clamp(0.16 + shade * 0.92) * edge;
              const radius = cell * 0.62 * f + 0.2;
              ctx.fillStyle = c.fg;
              ctx.globalAlpha = 0.1 + f * 0.68;
              ctx.beginPath();
              ctx.arc(x, y, radius, 0, Math.PI * 2);
              ctx.fill();
            }
          }
          ctx.globalAlpha = 1;
          // graticule
          ctx.strokeStyle = c.fg;
          ctx.lineWidth = 1;
          ctx.globalAlpha = 0.2;
          for (let i = -2; i <= 2; i++) {
            const rr = R * Math.abs(Math.cos(state.phase * 0.12 + (i * Math.PI) / 5));
            ctx.beginPath();
            ctx.ellipse(cx, cy, Math.max(1, rr), R, 0, 0, Math.PI * 2);
            ctx.stroke();
          }
          for (let i = -2; i <= 2; i++) {
            const yy = cy + (R * i) / 3;
            const rx = Math.sqrt(Math.max(0, R * R - (R * i) / 3 * ((R * i) / 3)));
            ctx.beginPath();
            ctx.ellipse(cx, yy, rx, Math.max(1, R * 0.12), 0, 0, Math.PI * 2);
            ctx.stroke();
          }
          ctx.globalAlpha = 1;
          // node arcs
          const nodes = [
            [-0.55, -0.22],
            [0.48, -0.42],
            [0.34, 0.52],
            [-0.28, 0.62],
            [-0.66, 0.3],
          ];
          const points = nodes.map(([nx, ny]) => [cx + nx * R * 0.92, cy + ny * R * 0.92]);
          ctx.strokeStyle = c.red;
          ctx.lineWidth = 1.2;
          ctx.globalAlpha = 0.72;
          const pairs = [
            [0, 1],
            [1, 2],
            [2, 3],
            [3, 4],
            [4, 0],
            [0, 2],
          ];
          pairs.forEach(([a, b], idx) => {
            const [x1, y1] = points[a];
            const [x2, y2] = points[b];
            const mx = (x1 + x2) / 2;
            const my = (y1 + y2) / 2;
            const bend = 0.24 + (idx % 3) * 0.06;
            const qx = mx + (my - cy) * bend * 0.1;
            const qy = my - (mx - cx) * bend * 0.1;
            ctx.beginPath();
            ctx.moveTo(x1, y1);
            ctx.quadraticCurveTo(qx, qy, x2, y2);
            ctx.stroke();
          });
          points.forEach(([x, y], i) => {
            ctx.fillStyle = c.red;
            ctx.globalAlpha = 0.95;
            ctx.beginPath();
            ctx.arc(x, y, i === 0 ? 3.2 : 2.2, 0, Math.PI * 2);
            ctx.fill();
            ctx.strokeStyle = c.red;
            ctx.globalAlpha = 0.45;
            ctx.beginPath();
            ctx.arc(x, y, 6 + (Math.sin(t * 0.9 + i) * 0.5 + 0.5) * 5, 0, Math.PI * 2);
            ctx.stroke();
          });
          ctx.globalAlpha = 1;
        }

        if (kind === 'field') {
          const cols = 16;
          const cell = w / cols;
          const hues = [0.9, 1.15, 1.4, 1.65];
          const phase = seed * 1.7;
          for (let y = cell * 0.5; y < h; y += cell) {
            for (let x = cell * 0.5; x < w; x += cell) {
              const nx = x / w;
              const ny = y / h;
              const wave =
                Math.sin(nx * 5.2 + Math.sin(ny * 3.1 + t * 0.5 + phase) * 1.4) * 0.5 +
                Math.sin((nx + ny) * 4.1 - t * 0.4 + phase) * 0.35;
              const bulb = Math.exp(-((nx - 0.5) ** 2 + (ny - 0.58) ** 2) * 11);
              const f = clamp(bulb * (0.7 + wave * 0.45));
              if (f < 0.03) continue;
              ctx.fillStyle = c.fg;
              ctx.globalAlpha = 0.12 + f * 0.7;
              ctx.beginPath();
              ctx.arc(x, y, cell * 0.46 * f + 0.2, 0, Math.PI * 2);
              ctx.fill();
              if (f > 0.62) {
                ctx.fillStyle = c.red;
                ctx.globalAlpha = (f - 0.55) * 1.4;
                ctx.beginPath();
                ctx.arc(x, y, cell * 0.2, 0, Math.PI * 2);
                ctx.fill();
              }
            }
          }
          ctx.globalAlpha = 1;
        }
      }

      canvases.forEach(setup);

      if (!reducedMotion) {
        let last = 0;
        const loop = (now) => {
          if (now - last > 45) {
            last = now;
            states.forEach((state, canvas) => {
              if (!state.visible) return;
              state.phase += 0.016;
              render(canvas, state);
            });
          }
          requestAnimationFrame(loop);
        };
        requestAnimationFrame(loop);
      }

      reveal();
    </script>
  </body>
</html>
