---
import Base from '../layouts/Base.astro';
import Signal from '../components/Signal.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import { releases } from '../data/site';
import { fmtDate, v } from '../lib/format';

const a = releases.autobot.latest;
const i = releases.invincible.latest;

const principles = [
  ['01', 'Owned means owned', 'Your keys, your weights, your logs, your machine. A product that needs a landlord is not a product we ship.'],
  ['02', 'Local is the default', 'Leaving hardware you own is always a choice, visible and reversible. The network is a tool, not the architecture.'],
  ['03', 'No phoning home', 'No telemetry, no update checks you did not ask for, no accounts. The record is local and checkable.'],
  ['04', 'Frontier-optional', 'Every feature has a path that works without a third party. Frontier models make things faster, not possible.'],
  ['05', 'Open, signed, measured', 'Source available. Reproducible builds. Signed releases. Claims that can be checked, and the numbers to check them against.'],
];
---
<Base path="/">
  <section class="hero">
    <div class="shell">
      <div class="hero__grid">
        <div class="hero__copy">
          <div class="hero__kicker">
            <span class="eyebrow">Independent studio · Open source</span>
            <span class="pill pill--red">Est. 2026</span>
          </div>
          <h1>
            <span class="line">Software that</span>
            <span class="line">answers to its owner.</span>
          </h1>
          <div class="hero__sub">
            <p>
              Sovware is an independent software studio. We build private intelligence for the
              phone and for the machine you own: software that runs locally, speaks open standards,
              and keeps a record its owner can check.
            </p>
          </div>
          <div class="hero__actions">
            <a class="btn" href="https://autobot.sh">Autobot <span class="btn__arrow">↗</span></a>
            <a class="btn btn--ghost" href="https://invincible.sh">Invincible <span class="btn__arrow">↗</span></a>
            <a class="btn btn--ghost hide-mobile" href="mailto:boy@wckd.cc">Contact</a>
          </div>
          <div class="hero__meta">
            <span>autobot.sh</span>
            <span>invincible.sh</span>
            <span>sovware.io</span>
            <span><i class="dot" style="width:5px;height:5px"></i> wckd.ai → here</span>
          </div>
        </div>

        <div class="hero__art">
          <div style="position:relative">
            <Signal
              kind="optic"
              topLeft="Figure 1"
              topRight="Open"
              bottomLeft="Two products"
              bottomRight="2026"
              label="Sovereign software"
              aria="A halftone optic representing the studio"
            />
          </div>
          <dl class="readouts">
            <div class="readout"><dt>Autobot</dt><dd>v{v(a.tag)}</dd></div>
            <div class="readout"><dt>Invincible</dt><dd>v{v(i.tag)}</dd></div>
            <div class="readout"><dt>Licenses</dt><dd>Apache · MIT</dd></div>
            <div class="readout"><dt>Telemetry</dt><dd class="red">None</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  
  <div class="shell">
    <dl class="trustbar">
      <div><dt>Studio</dt><dd>Independent</dd></div>
      <div><dt>Products</dt><dd>Autobot · Invincible</dd></div>
      <div><dt>Licenses</dt><dd>Apache-2.0 · MIT</dd></div>
      <div><dt>Telemetry</dt><dd>None</dd></div>
      <div><dt>Source</dt><dd>github.com/wckdboy</dd></div>
    </dl>
  </div>
  <section class="section" id="work">
    <div class="shell">
      <SectionHead num="01" label="The work">
        <Fragment slot="title">Two products,<br />one idea of ownership.</Fragment>
        <Fragment slot="note">
          The phone is the first computer you own. The node is the second. Together they cover the
          space between “on my device” and “in someone else’s cloud”.
        </Fragment>
      </SectionHead>

      <div class="products">
        <a class="product" href="https://autobot.sh" data-reveal>
          <div class="product__top">
            <span class="pill pill--red">v{v(a.tag)} · shipping</span>
            <span class="product__index">01 / Phone</span>
          </div>
          <div>
            <h2 class="product__bm">Auto<em>bot</em></h2>
            <p>
              A private AI agent for Android and iOS. Chat, agents, image generation and voice run
              on the NPU, GPU and CPU. Offline by default, redacted before the cloud, a receipt for
              every answer.
            </p>
          </div>
          <span class="product__go">Visit autobot.sh <span aria-hidden="true">→</span></span>
        </a>

        <a class="product" href="https://invincible.sh" data-reveal>
          <div class="product__top">
            <span class="pill pill--red">v{v(i.tag)} · early</span>
            <span class="product__index">02 / Node</span>
          </div>
          <div>
            <h2 class="product__bm">Invin<em>cible</em></h2>
            <p>
              A self-hosted AI node for a desktop, GPU box or VPS. Serves open models behind
              standard APIs, routes by policy, signs every receipt, and keeps working when the
              cloud is gone.
            </p>
          </div>
          <span class="product__go">Visit invincible.sh <span aria-hidden="true">→</span></span>
        </a>
      </div>

      <div class="scene-strip mt-3">
        <div><b>On the phone</b><span>NPU · GPU · CPU · offline</span></div>
        <div><b>On your node</b><span>llama.cpp · always on · signed</span></div>
        <div><b>On your terms</b><span>frontier only when the rules allow</span></div>
      </div>
    </div>
  </section>

  <section class="section section--rule" id="principles">
    <div class="shell">
      <SectionHead num="02" label="Principles">
        <Fragment slot="title">How we build.</Fragment>
        <Fragment slot="note">
          These are design constraints, not marketing lines. They decide what we ship and what we
          refuse to.
        </Fragment>
      </SectionHead>

      <div class="ledger">
        {principles.map(([n, title, body]) => (
          <div class="ledger__row" data-reveal>
            <span class="ledger__n">{n}</span>
            <h3 class="ledger__t">{title}</h3>
            <p class="ledger__d">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section is-ink">
    <div class="shell">
      <div class="split">
        <div class="split__aside">
          <span class="eyebrow">The studio</span>
          <h2 class="title-xl mt-2" style="font-size:clamp(2.6rem,6vw,6rem)">Small by<br />design.</h2>
        </div>
        <div class="split__main">
          <div class="prose">
            <p>
              Sovware is an independent software studio. We work on the layer between a model and a
              person: the runtime, the policy, the record, the interface. <b>The work is public</b>
              — the repositories, the specs, the conformance vectors and the release signatures are
              the record.
            </p>
            <p>
              The studio domain is <b>sovware.io</b>. The products live on their own names:
              <b>autobot.sh</b> and <b>invincible.sh</b>. <b>wckd.ai</b> resolves here.
            </p>
          </div>
          <div class="two-col mt-4">
            <div class="aside-rule">
              <h3>Domains</h3>
              <div class="kv"><span>autobot.sh</span><b>Product</b></div>
              <div class="kv"><span>invincible.sh</span><b>Product</b></div>
              <div class="kv"><span>sovware.io</span><b>Studio</b></div>
              <div class="kv"><span>wckd.ai</span><b>Redirect</b></div>
            </div>
            <div class="aside-rule">
              <h3>Contact</h3>
              <div class="kv"><span>Email</span><b><a href="mailto:boy@wckd.cc">boy@wckd.cc</a></b></div>
              <div class="kv"><span>GitHub</span><b><a href="https://github.com/wckdboy" rel="noopener">wckdboy ↗</a></b></div>
              <div class="kv"><span>Autobot</span><b><a href="https://github.com/wckdboy/autobot" rel="noopener">source ↗</a></b></div>
              <div class="kv"><span>Invincible</span><b><a href="https://github.com/wckdboy/invincible" rel="noopener">source ↗</a></b></div>
            </div>
          </div>
          <p class="mono mt-4" style="font-size:9px;line-height:1.9;letter-spacing:.09em;color:var(--muted)">
            LATEST · AUTOBOT {v(a.tag)} ({fmtDate(a.published)}) · INVINCIBLE {v(i.tag)} ({fmtDate(i.published)})
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="shell">
      <div class="callout" data-reveal>
        <div>
          <span class="eyebrow no-rule">Start with the phone</span>
          <h2 class="mt-2">Private intelligence<br />is already here.</h2>
          <p>
            Download Autobot, or put Invincible on a machine you own. No account. No telemetry. No
            request you did not make.
          </p>
        </div>
        <div class="callout__actions">
          <a class="btn" href="https://autobot.sh">Autobot <span class="btn__arrow">↗</span></a>
          <a class="btn btn--ghost" href="https://invincible.sh">Invincible <span class="btn__arrow">↗</span></a>
          <a class="btn btn--ghost" href="mailto:boy@wckd.cc"><Icon name="chat" size={12} /> Say hello</a>
        </div>
      </div>
    </div>
  </section>
</Base>
