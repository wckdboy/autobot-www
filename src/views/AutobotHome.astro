---
import Base from '../layouts/Base.astro';
import Signal from '../components/Signal.astro';
import SectionHead from '../components/SectionHead.astro';
import Terminal from '../components/Terminal.astro';
import Releases from '../components/Releases.astro';
import Icon from '../components/Icon.astro';
import { releases, meta } from '../data/site';
import { fmtDate, v } from '../lib/format';

const latest = releases.autobot.latest;
const apk = latest.assets.find((a) => /release\.apk$/.test(a.name));
const debugApk = latest.assets.find((a) => /debug\.apk$/.test(a.name));
const sums = latest.assets.find((a) => a.name === 'SHA256SUMS.txt');
const apkHash = releases.autobot.checksums
  ?.split('\n')
  .find((l) => l.includes('release.apk'))
  ?.split(/\s+/)[0];
const cert = '9a1378acf9587885e7920355558c85a1ec0e89304f58c153feebf90fdee7f3f1';

const modes = [
  {
    n: '01',
    name: 'Image',
    body: 'SD 1.5, SDXL, Z-Image and FLUX.2 klein on the phone. LoRA stacks, inpainting, a mask editor, seeds and batches. Core ML on the Neural Engine when you are on iOS.',
    foot: 'TXT2IMG · IMG2IMG · INPAINT',
    seed: 0,
  },
  {
    n: '02',
    name: 'Chat',
    body: 'Local models with streaming, reasoning, tool calls, MCP servers and an optional phone-first cascade. A receipt on every answer, not a promise in a policy.',
    foot: 'MCP · CASCADE · RECEIPTS',
    seed: 1,
  },
  {
    n: '03',
    name: 'Agent',
    body: 'A real agent runtime: read, write, edit, glob, grep, web fetch, subagents and skills. Approvals fail closed. Recipes run scheduled agents on the phone.',
    foot: 'TOOLS · APPROVALS · RECIPES',
    seed: 2,
  },
  {
    n: '04',
    name: 'Code',
    body: 'Sessions in a private workspace where the model never sees a real path. Tool calls arrive as cards; check the diff, allow it, and keep working.',
    foot: 'WORKSPACE · DIFFS · UNDO',
    seed: 3,
  },
];

const engines = [
  ['Language', 'llama.cpp in its own process, with the best ARM variant of the build picked at runtime.', 'CPU · Adreno GPU · Hexagon NPU'],
  ['Images', 'stable-diffusion.cpp on Android, Core ML on iOS. Any downloaded checkpoint and LoRA.', 'GPU · NPU · Neural Engine'],
  ['Voice', 'whisper.cpp streaming dictation and spoken answers with barge-in. Audio never leaves the phone.', 'CPU · Metal'],
  ['Fallback', 'The OS model stands in when a downloaded model is missing, too big, or fails to load — and the chat says so.', 'Gemini Nano · opt-in flavor'],
];

const ledger = [
  ['01', 'Offline by default', 'The global network mode starts at Offline. A kill switch rejects every request before DNS or a socket exists. Loopback models such as Ollama can still be reached — or switched off too.'],
  ['02', 'Visible egress', 'The Privacy Center keeps a live, in-memory audit of every request attempt: time, method, host, path, sizes and whether it was blocked. Headers, query strings and bodies are never recorded.'],
  ['03', 'Redacted before cloud', 'Names, emails, phone numbers, addresses, cards, IBANs and account numbers become placeholders before a provider sees them. The answer gets the real values back on the phone. Each chat can switch it off.'],
  ['04', 'Encrypted at rest', 'Conversations live in Room over SQLCipher. A random 256-bit database key is wrapped by an AES-256-GCM keystore key, StrongBox when the phone has it. API keys are treated the same way.'],
  ['05', 'Panic wipe', 'Type WIPE to destroy keystore keys, wrapped keys, databases, settings, secrets and caches. The process is killed. A duress PIN and wipe-after-failed-unlocks are there for worse days.'],
  ['06', 'No telemetry', 'No Play Services, Firebase, analytics or crash reporting. No device identifiers. The User-Agent is the constant “Autobot”. Backups and device transfer are disabled.'],
];

const goals = [
  ['1', 'On-device first', 'Every feature works offline on the phone’s fastest accelerator. The network is an opt-in tool, never a requirement.'],
  ['2', 'Private by construction', 'Nothing leaves unless you can see it in the audit log and could have switched it off. No telemetry, ever.'],
  ['3', 'One app, two platforms', 'Android and iOS ship the same features, version and behaviour. Logic lives in shared code; only UI and OS glue is per platform.'],
  ['4', 'The riso feel', 'One signal red on ink or paper, Antonio and JetBrains Mono, halftones. The same tokens draw the app and this page.'],
];

const tabs = [
  { id: 'android', label: 'Android' },
  { id: 'ios', label: 'iOS' },
  { id: 'agent', label: 'Autobot Agent' },
];
---
<Base path="/">
  <section class="hero">
    <div class="shell">
      <div class="hero__grid">
        <div class="hero__copy">
          <div class="hero__kicker">
            <span class="eyebrow">Open source · Android and iOS</span>
            <span class="pill pill--red">Latest v{v(latest.tag)}</span>
          </div>
          <h1>
            <span class="line">Private AI,</span>
            <span class="line">on your phone.</span>
          </h1>
          <div class="hero__sub">
            <p>
              Autobot runs chat, agents, image generation and voice on your device — on the
              NPU, GPU and CPU. It works offline by default, redacts before any cloud call, and
              gives every answer a privacy receipt.
            </p>
          </div>
          <div class="hero__actions">
            <a class="btn" href={apk?.url} rel="noopener">
              <Icon name="download" size={13} /> Download {v(latest.tag)}
            </a>
            <a class="btn btn--ghost" href="/install#agent">
              Install guide <span class="btn__arrow">→</span>
            </a>
            <a class="btn btn--ghost hide-mobile" href={meta.repo} rel="noopener">
              <Icon name="github" size={13} /> Source
            </a>
          </div>
          <div class="hero__meta">
            <span>Android 14+ · arm64</span>
            <span>iOS 18+</span>
            <span><i class="dot" style="width:5px;height:5px"></i> Offline by default</span>
            <span>{apk ? `${(apk.size / 1024 / 1024).toFixed(1)} MB APK` : 'Signed APK'}</span>
          </div>
        </div>

        <div class="hero__art">
          <div style="position:relative">
            <Signal
              kind="optic"
              topLeft="Figure 1"
              topRight="Local"
              bottomLeft="No egress"
              bottomRight={`v${v(latest.tag)}`}
              label="On-device inference"
              aria="A halftone optic, drawn live from dots, representing the on-device model"
            />
          </div>
          <dl class="readouts">
            <div class="readout"><dt>Release</dt><dd>{v(latest.tag)}</dd></div>
            <div class="readout"><dt>Engine</dt><dd>Llama.cpp</dd></div>
            <div class="readout"><dt>Devices</dt><dd>Android / iOS</dd></div>
            <div class="readout"><dt>Network</dt><dd class="red">Offline</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>


  <div class="shell">
    <dl class="trustbar">
      <div><dt>Latest release</dt><dd>v{v(latest.tag)}</dd></div>
      <div><dt>License</dt><dd>Apache-2.0</dd></div>
      <div><dt>Platforms</dt><dd>Android 14+ · iOS 18+</dd></div>
      <div><dt>Default network</dt><dd><span class="dot"></span>Offline</dd></div>
      <div><dt>Telemetry</dt><dd>None</dd></div>
    </dl>
  </div>
  <section class="section section--tight" id="system">
    <div class="shell">
      <SectionHead num="01" label="The system">
        <Fragment slot="title">Built to run<br />without a network.</Fragment>
        <Fragment slot="note">
          Autobot is one app with two native skins and one Kotlin Multiplatform core. The engines are
          shared C, the privacy rules are shared code, and the design tokens are the same file on
          both platforms. A behaviour fix lands everywhere at once.
        </Fragment>
      </SectionHead>

      <div class="statements">
        <div class="statement" data-reveal>
          <span class="statement__n">A</span>
          <h3 class="statement__t">The metal does the work</h3>
          <p class="statement__d">
            Each engine runs in its own process, so a native crash or an out-of-memory kill ends
            that engine — not the app. The engines never touch the network. On Android the build
            picks the best ARM feature level at runtime, from ARMv8.0 to ARMv9.2 with i8mm and SVE2.
          </p>
        </div>
        <div class="statement" data-reveal>
          <span class="statement__n">B</span>
          <h3 class="statement__t">Privacy is not a setting</h3>
          <p class="statement__d">
            The kill switch, the audit log, the redaction rules and the network modes are shared
            code, not platform promises. A cloud request passes redaction first, and its receipt
            counts what was hidden. The default is <b>no request at all</b>.
          </p>
        </div>
        <div class="statement" data-reveal>
          <span class="statement__n">C</span>
          <h3 class="statement__t">Two apps, one behaviour</h3>
          <p class="statement__d">
            Android and iOS ship the same version and build. The agent runtime, provider wire
            formats, model catalog, download state machine and <b>.autobot</b> export format are
            shared. The export file opens on the other platform.
          </p>
        </div>
      </div>

      <dl class="stats mt-4" data-reveal>
        <div class="stat"><dt>Platforms</dt><dd>02<small>Android · iOS</small></dd></div>
        <div class="stat"><dt>Ways to run</dt><dd>04<small>Image · Chat · Agent · Code</small></dd></div>
        <div class="stat"><dt>Telemetry</dt><dd>00<small>No SDKs · no identifiers</small></dd></div>
        <div class="stat"><dt>Shared core</dt><dd>01<small>Kotlin Multiplatform</small></dd></div>
      </dl>
    </div>
  </section>

  <section class="section section--tight">
    <div class="shell">
      <SectionHead num="02" label="Capabilities">
        <Fragment slot="title">Four modes.<br />One runtime.</Fragment>
        <Fragment slot="note">
          Everything below runs without a network. Cloud providers are optional, and every one of
          them goes through the same policy, redaction and receipt.
        </Fragment>
      </SectionHead>

      <div class="modes">
        {modes.map((m, i) => (
          <article class="mode" data-reveal style={`--d:${i * 60}ms`}>
            <div class="mode__top">
              <span>{m.foot}</span>
              <span>{m.n}</span>
            </div>
            <div class="mode__glyph">
              <canvas data-halftone="field" data-seed={m.seed} aria-hidden="true"></canvas>
            </div>
            <div class="mode__bottom">
              <h3>{m.name}</h3>
              <p>{m.body}</p>
            </div>
            <span class="mode__idx" aria-hidden="true">{m.n}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section is-ink">
    <div class="shell">
      <SectionHead num="03" label="On the metal">
        <Fragment slot="title">Native engines,<br />no cloud in the loop.</Fragment>
        <Fragment slot="note">
          llama.cpp, stable-diffusion.cpp and whisper.cpp are built from pinned sources. On Android
          the image path can also use the Hexagon NPU through QNN or the Adreno GPU through MNN; on
          iOS, Core ML uses the Neural Engine.
        </Fragment>
      </SectionHead>

      <div class="split">
        <div class="split__aside">
          <div class="quote quote--small">
            A 4B model is useful on a phone.
          </div>
          <p class="byline">On-device inference · llama.cpp</p>
          <div class="note mt-3" style="background:color-mix(in srgb, var(--amber) 10%, transparent)">
            <b>Status, honestly:</b> the Snapdragon accelerator paths are built for the 8 Elite Gen 5
            (Hexagon V81, Adreno 840) and have not yet been run on one. Models → Compute → report is
            the diagnostics that will confirm them.
          </div>
        </div>
        <div class="split__main">
          <div class="table-wrap"><table class="data">
            <thead>
              <tr><th>Engine</th><th>What runs</th><th>Accelerator</th></tr>
            </thead>
            <tbody>
              {engines.map(([name, desc, accel]) => (
                <tr>
                  <td>{name}</td>
                  <td data-label="What runs">{desc}</td>
                  <td class="mono" data-label="Accelerator">{accel}</td>
                </tr>
              ))}
            </tbody>
          </table></div>
          <p class="mono mt-3" style="font-size:9px;letter-spacing:.1em;color:var(--muted)">
            Models · Qwen3.5 0.8B–4B · Gemma 4 E2B · Phi-4 mini · Llama 3.2 3B · Qwen2.5 Coder ·
            SD 1.5 · SDXL Turbo · FLUX.2 klein 4B. Fit checked against RAM, storage and CPU features.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHead num="04" label="Privacy, itemised">
        <Fragment slot="title">Privacy you<br />can inspect.</Fragment>
        <Fragment slot="note">
          These are the guarantees the code makes, not a policy page. The rules live in shared
          modules and are tested on both platforms.
        </Fragment>
      </SectionHead>

      <div class="split">
        <div class="split__main split__main--wide">
          <div class="ledger">
            {ledger.map(([n, title, body]) => (
              <div class="ledger__row" data-reveal>
                <span class="ledger__n">{n}</span>
                <h3 class="ledger__t">{title}</h3>
                <p class="ledger__d">{body}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="split mt-4">
        <div class="split__aside">
          <div class="receipt" data-reveal>
            <div class="receipt__head"><span>Privacy receipt</span><span>#4F2A</span></div>
            <div class="receipt__row"><span>Route</span><b>This phone</b></div>
            <div class="receipt__row"><span>Model</span><b>Qwen3.5 4B</b></div>
            <div class="receipt__row"><span>Network</span><b class="ok">Offline</b></div>
            <div class="receipt__row"><span>Egress</span><b>0 bytes</b></div>
            <div class="receipt__row"><span>Redacted</span><b>3 items</b></div>
            <div class="receipt__row"><span>Stored</span><b>SQLCipher</b></div>
            <div class="receipt__foot"><span>Example</span><span>Verified on device</span></div>
          </div>
        </div>
        <div class="split__main">
          <p class="lede">
            A chat is not a black box with a lock icon on it. The receipt tells you where the answer
            ran, what was hidden before it left, and how many bytes crossed the wire. If the answer
            came from a paired node, its signed receipt is merged in too.
          </p>
          <div class="hero__actions">
            <a class="btn btn--ghost" href="/privacy">Read the privacy model <span class="btn__arrow">→</span></a>
            <a class="link" href="/releases">Release notes</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--rule">
    <div class="shell">
      <SectionHead num="05" label="The node">
        <Fragment slot="title">When the phone<br />is not enough.</Fragment>
        <Fragment slot="note">
          Invincible is the middle tier: a desktop, GPU box or VPS that serves stronger open models
          and runs agents without a battery. Pair it once; the phone keeps its rules.
        </Fragment>
      </SectionHead>

      <div class="pair" data-reveal>
        <div class="pair__node">
          <span class="mono">Tier 01</span>
          <b>This phone</b>
          <span>NPU · GPU · offline</span>
        </div>
        <div class="pair__link" aria-hidden="true"></div>
        <div class="pair__node">
          <span class="mono">Tier 02</span>
          <b>My node</b>
          <span>Invincible · always on</span>
        </div>
        <div class="pair__link" aria-hidden="true"></div>
        <div class="pair__node">
          <span class="mono">Tier 04</span>
          <b>Cloud</b>
          <span>Only when rules allow</span>
        </div>
      </div>

      <div class="mt-4" data-reveal>
        <Terminal
          title="install the autobot agent + invincible gateway"
          command="curl -fsSL https://invincible.sh/install.sh | sh"
          lines={[
            { kind: "dim", text: "# macOS arm64 · Linux x64 / arm64 · no root" },
            { kind: "ok", text: "→ signed release · pinned key · model sized to this machine" },
          ]}
          copyText="curl -fsSL https://invincible.sh/install.sh | sh"
          note={["Same agent as the phone", "Always on", "Approvals on the phone"]}
        />
      </div>

      <div class="split mt-4">
        <div class="split__aside">
          <h3 class="title-m">One endpoint.<br />Your hardware.</h3>
          <p class="section-lede mt-2">
            Pairing is a QR code and a Noise handshake. No account, no relay, no API key. The node
            appears in Autobot as <b>My node</b>, with its live model list and signed receipts.
          </p>
          <div class="hero__actions">
            <a class="btn btn--ghost" href="https://invincible.sh">Meet Invincible <span class="btn__arrow">↗</span></a>
          </div>
        </div>
        <div class="split__main">
          <ul class="checklist">
            <li><span><b>Chats and agents on the node</b> — the same approval cards, the same session log, on a machine with a real GPU.</span></li>
            <li><span><b>Recipes without the 8-minute limit</b> — hand a scheduled task to the node; results come back as chats with the node’s receipts.</span></li>
            <li><span><b>Phone → node → cloud</b> — “never” now means “never beyond hardware I own”. The node counts as owned.</span></li>
            <li><span><b>The node is early build</b> — core paths work end to end; the independent security review is still ahead. We say so on its site, too.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section is-paper" id="install">
    <div class="shell">
      <SectionHead num="06" label="Install">
        <Fragment slot="title">Get it running.</Fragment>
        <Fragment slot="note">
          The app is a signed APK and a TestFlight build. The agent is one script that also installs
          the node. Both are verifiable; neither needs an account.
        </Fragment>
      </SectionHead>

      <div class="split" data-tabs>
        <div class="split__aside">
          <div class="tabs" role="tablist" aria-label="Install options">
            {tabs.map((t, i) => (
              <button
                class="tab"
                role="tab"
                id={`tab-${t.id}`}
                aria-controls={`panel-${t.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? '0' : '-1'}
                type="button"
              >{t.label}</button>
            ))}
          </div>
          <div class="note">
            <b>No account.</b> No email, no OAuth, no tenant. Download, sideload, and the app starts
            in Offline mode with no model installed.
          </div>
          <div class="aside-rule mt-3">
            <h3>What you need</h3>
            <div class="kv"><span>Android</span><b>14+ · arm64</b></div>
            <div class="kv"><span>iOS</span><b>18+ · TestFlight</b></div>
            <div class="kv"><span>Agent</span><b>macOS arm64 · Linux x64/arm64</b></div>
            <div class="kv"><span>License</span><b>Apache-2.0</b></div>
          </div>
        </div>

        <div class="split__main">
          <div class="tabpanel" role="tabpanel" id="panel-android" aria-labelledby="tab-android">
            <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;margin-bottom:14px">
              <div>
                <span class="eyebrow no-rule">Primary artifact</span>
                <p class="title-m" style="margin-top:6px">{apk?.name ?? 'autobot-release.apk'}</p>
              </div>
              <a class="btn" href={apk?.url} rel="noopener"><Icon name="download" size={13} /> Download APK</a>
            </div>
            <Terminal
              title="verify the download"
              command={`shasum -a 256 ${apk?.name ?? 'autobot-release.apk'}`}
              lines={[
                { kind: 'dim', text: apkHash ? `# ${apkHash}` : '# compare with SHA256SUMS.txt' },
                { kind: 'dim', text: 'apksigner verify --print-certs <apk>' },
                { kind: 'dim', text: `# SHA-256 ${cert.slice(0, 24)}…` },
              ]}
              note={['Android 14+, arm64', 'Signed with autobot-release-2026', 'Cert fingerprint on GitHub']}
            />
            <p class="mono mt-3" style="font-size:9px;line-height:1.8;letter-spacing:.09em;color:var(--muted)">
              {sums ? <a class="link" href={sums.url} rel="noopener">SHA256SUMS.txt ↗</a> : null}
              {' · '}
              <a class="link" href={latest.url} rel="noopener">Release notes ↗</a>
              {' · '}
              <a class="link" href={debugApk?.url ?? latest.url} rel="noopener">Debug build</a>
            </p>
          </div>

          <div class="tabpanel" role="tabpanel" id="panel-ios" aria-labelledby="tab-ios" hidden>
            <p class="lede">
              iOS ships the same version and build as Android, on TestFlight as
              <code class="inline-code">ai.wckd.autobot</code>. If the beta is full, the repository
              documents a local build with Xcode.
            </p>
            <div class="hero__actions">
              <a class="btn btn--ghost" href="https://github.com/wckdboy/autobot/blob/main/ios/README.md" rel="noopener">
                Build for iPhone <span class="btn__arrow">↗</span>
              </a>
              <a class="link" href={meta.repo + '/releases'} rel="noopener">Release history</a>
            </div>
            <div class="inset mt-3">
              <div class="kv"><span>Bundle ID</span><b>ai.wckd.autobot</b></div>
              <div class="kv"><span>Version</span><b>{v(latest.tag)}</b></div>
              <div class="kv"><span>Frameworks</span><b>AutobotShared.xcframework</b></div>
              <div class="kv"><span>Engines</span><b>Metal · Core ML · whisper.cpp</b></div>
            </div>
          </div>

          <div class="tabpanel" role="tabpanel" id="panel-agent" aria-labelledby="tab-agent" hidden>
            <p class="lede">
              The Autobot Agent is the same agent as the phone’s, for a machine that never sleeps.
              One script installs it next to Invincible Gateway, then runs <b>autobot setup</b>:
              network, model, approvals, Telegram, background services. No root.
            </p>
            <Terminal
              title="install the autobot agent + gateway"
              command="curl -fsSL https://invincible.sh/install.sh | sh"
              lines={[
                { kind: 'dim', text: '# macOS arm64 · Linux x64 / arm64' },
                { kind: 'ok', text: '→ invincible, autobot → ~/.local/bin' },
                { kind: 'ok', text: '→ llama.cpp if missing · model sized to this machine' },
                { kind: 'ok', text: '→ autobot setup: network · model · agent · Telegram · background' },
              ]}
              copyText="curl -fsSL https://invincible.sh/install.sh | sh"
              note={['Signed release · pinned key', 'Reproducible Linux builds', 'Falls back to building from source']}
            />
            <div class="hero__actions">
              <a class="btn btn--ghost" href="/install#agent">Agent install notes <span class="btn__arrow">→</span></a>
              <a class="link" href="https://invincible.sh/verify">How it verifies</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHead num="07" label="Releases">
        <Fragment slot="title">Release history.</Fragment>
        <Fragment slot="note">
          Pulled from GitHub at build time. Every release carries its notes, its files and — for the
          Android APK — a published SHA-256. Versions move together on both platforms.
        </Fragment>
      </SectionHead>

      <Releases releases={releases.autobot.releases} repo="autobot" limit={4} openFirst={false} />
      <div class="hero__actions mt-3">
        <a class="btn btn--ghost" href="/releases">All releases <span class="btn__arrow">→</span></a>
        <span class="mono" style="font-size:9px;color:var(--muted);display:inline-flex;align-items:center">
          Data {fmtDate(releases.generatedAt)} · v{v(latest.tag)} latest
        </span>
      </div>
    </div>
  </section>

  <section class="section section--rule">
    <div class="shell">
      <SectionHead num="08" label="Roadmap">
        <Fragment slot="title">Roadmap.</Fragment>
        <Fragment slot="note">
          The roadmap is public. A phase is done when its exit criteria hold on both platforms and
          on real hardware — not when the build passes.
        </Fragment>
      </SectionHead>

      <div class="split">
        <div class="split__main">
          <div class="ledger">
            {goals.map(([n, title, body]) => (
              <div class="ledger__row">
                <span class="ledger__n">G{n}</span>
                <h3 class="ledger__t">{title}</h3>
                <p class="ledger__d">{body}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="split__aside">
          <div class="inset">
            <span class="eyebrow no-rule">Now</span>
            <p class="title-m mt-2" style="font-size:2rem">Phase 0 · 1.2.x</p>
            <p class="section-lede mt-2">
              Shipping and verifying. The accelerators are built and the shared core is live; the
              remaining gate is real-hardware verification on the 8 Elite Gen 5.
            </p>
            <div class="status-row">
              <span class="live">In progress</span>
              <span>Both platforms</span>
            </div>
            <div class="aside-rule mt-3">
              <h3>Read the plan</h3>
              <a class="link" href="https://github.com/wckdboy/autobot/blob/main/ROADMAP.md" rel="noopener">
                ROADMAP.md <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
          <div class="note mt-3">
            <b>Verified, not assumed.</b> The Snapdragon NPU and Adreno paths still need a run on
            the hardware they were built for. The diagnostics report is how that gets closed.
          </div>
        </div>
      </div>
    </div>
  </section>

