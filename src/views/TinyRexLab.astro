---
import Lab from '../layouts/Lab.astro';

// "tinyrex" in the kit's lettering: lowercase, six cells tall, two-cell strokes, one cell apart.
const LETTERS: Record<string, string[]> = {
  t: ['##....', '#####.', '##....', '##....', '##..##', '.####.'],
  i: ['##', '..', '##', '##', '##', '##'],
  n: ['#####.', '##..##', '##..##', '##..##', '##..##', '##..##'],
  y: ['##..##', '##..##', '##..##', '.#####', '....##', '#####.'],
  r: ['#####.', '##..##', '##....', '##....', '##....', '##....'],
  e: ['.####.', '##..##', '######', '##....', '##....', '.#####'],
  x: ['##..##', '##..##', '.####.', '.####.', '##..##', '##..##'],
};
function pixelWord(word: string) {
  const rects: string[] = [];
  let ox = 0;
  for (const ch of word) {
    const g = LETTERS[ch];
    g.forEach((row, y) => {
      for (let x = 0; x < row.length; x++) if (row[x] === '#') rects.push(`<rect x="${ox + x}" y="${y}" width="1" height="1"/>`);
    });
    ox += g[0].length + 1;
  }
  const w = ox - 1;
  return { w, svg: `<svg viewBox="0 0 ${w + 2} 6" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true">${rects.join('')}<rect class="dot" x="${w + 1}" y="5" width="1" height="1"/></svg>` };
}
const word = pixelWord('tinyrex');

const REPO = 'https://github.com/wckdboy/tinyrex';

const stats = [
  ['17', 'servo joints'],
  ['163', 'parts'],
  ['1.68 kg', 'all in'],
  ['78.7 mm', 'walked in MuJoCo, no fall'],
];

const specs = [
  ['Joints', '17 revolute: six per leg (hip yaw, roll and pitch, knee, ankle pitch and roll), neck pitch, head pitch, head yaw, jaw and tail yaw'],
  ['Actuators', '16 Feetech STS3215 serial servos, and an SG90 micro servo for the jaw'],
  ['Parts', '163, including 84 socket-head screws'],
  ['Mass', '1.68 kg (1.676 kg measured in Polykrom)'],
  ['Compute', 'Raspberry Pi Zero 2 W'],
  ['IMU', 'BNO085'],
  ['Power', '2S 1000 mAh LiPo'],
  ['Shells', 'printed PLA in lime, with a black armour plate, dorsal spikes and claws, off-white teeth and TPU foot pads'],
];

const results = [
  ['24.7 mm', 'smallest stability margin through the whole walk, against 5 mm required (Polykrom statics)'],
  ['78.7 mm', 'walked forward in MuJoCo with the body free: two cycles at 0.08 s per step, no fall, no drift, at most 0.41° of tilt'],
  ['60%', 'peak knee torque of its 1.91 N·m rating in that walk; nothing else in the legs above 36%'],
  ['48.4 mm', 'standing stability margin, the hardest-working servo at 2.4% of stall'],
];

// The concept TinyRex is being built toward (WCKD's concept art): product views and earlier boards.
const views = [
  ['left', 'Left side', 1536, 1024],
  ['front', 'Front', 1024, 1536],
  ['right', 'Right side', 1536, 1024],
  ['rear', 'Rear', 1024, 1536],
  ['top', 'From above', 1774, 887],
];
const boards = [
  ['board-mascot', 'TinyREX as the Polykrom mascot, with pixel state icons'],
  ['board-questions', 'Small body, big questions: design, simulate, experiment'],
  ['board-experiments', 'Small machine, big experiments'],
  ['board-arms', 'Articulated, expressive arms'],
];

const stages = [
  ['1. Torso', 'lofted chest shell, armour plate and spikes, Pi, IMU and battery on standoffs and a strap, two hip yaw servos', '91', '5.30'],
  ['2. Left leg', 'six servos on printed brackets, thigh, shin and a three-toed clawed foot; swept every joint for collisions', '68', '6.75'],
  ['3. Right leg', 'mirrored the leg with real, unmirrored servos turned to match; checked joint isolation and interference', '89', '5.47'],
  ['4. Head, tail, arms', 'neck and head servos, a skull with teeth and an SG90 jaw, a tapering tail, tiny arms', '219', '≥ 3.89'],
  ['5. Stand', 'standing pose, statics on two feet and on one, and four faults left by earlier stages fixed', '93', '4.90'],
  ['6. Walk', 'a 272-step gait worked out from the leg geometry, statics over the gait, interference, MuJoCo', '42', '1.68'],
  ['7. Export', 'MJCF, the render, the bill of materials and a MuJoCo standing check', '63', '2.56'],
];
---

<Lab
  path="/"
  current="overview"
  description="TinyRex is a small bipedal T-rex robot with 17 servos, designed from an empty file by an AI agent in Polykrom, then checked standing and walking in Polykrom and in MuJoCo."
>
  <section class="hero" aria-labelledby="rex-title">
    <p class="kicker">flagship demo · designed in polykrom</p>
    <h1 id="rex-title" class="word" aria-label="TinyRex"><Fragment set:html={word.svg} /></h1>
    <p class="pitch">A small bipedal T-rex robot, designed from an empty file by an AI agent working in Polykrom, then checked standing and walking in Polykrom and in MuJoCo.</p>
    <p class="stats-label">the current build, verified</p>
    <dl class="stats">
      {stats.map(([n, t]) => (<div><dt>{t}</dt><dd>{n}</dd></div>))}
    </dl>
    <div class="hero-actions">
      <a class="cta" href="#model">Turn the current build in 3D</a>
      <a href={REPO} rel="noopener">Source and design</a>
      <a href={`${REPO}/blob/main/results/rex-bom.csv`} rel="noopener">Bill of materials</a>
    </div>
    <figure class="concept-hero">
      <a href="/rex/concept/hero.webp"><img src="/rex/concept/hero.webp" srcset="/rex/concept/hero-768.webp 768w, /rex/concept/hero.webp 1536w" sizes="(max-width: 760px) 100vw, 1120px" width="1536" height="1024" fetchpriority="high" decoding="async" alt="Concept art of TinyRex: a small robot T-rex with faceted cream, lime and black shells, a lime head with a camera in each eye, a long segmented tail and articulated legs." /></a>
      <figcaption>Concept art: where TinyRex is going. <a href="#concept">More views</a></figcaption>
    </figure>
  </section>

  <section id="concept" aria-labelledby="concept-title">
    <h2 id="concept-title">where it's going</h2>
    <p>This is the concept TinyRex is being built toward. The agent is restyling the CAD model to it now: cream, lime and black faceted shells, a Raspberry Pi 5 with the AI HAT+, a removable battery, and stereo cameras in the eyes. The 3D model and renders further down are the current build; they will update when the restyle lands.</p>
    <ul class="views">
      {views.map(([k, label, w, h]) => (
        <li class={`view view--${k}`}>
          <a href={`/rex/concept/${k}.webp`}>
            <img src={`/rex/concept/${k}-480.webp`} srcset={`/rex/concept/${k}-480.webp 480w, /rex/concept/${k}.webp ${w}w`} sizes="(max-width: 760px) 50vw, 210px" width={480} height={Math.round(480 * h / w)} loading="lazy" decoding="async" alt={`TinyRex concept, ${label.toLowerCase()} view`} />
          </a>
          <span>{label}</span>
        </li>
      ))}
    </ul>
    <h3 class="boards-title">earlier concept directions</h3>
    <p class="small">Boards from the exploration that led to the concept above: directions, not specifications.</p>
    <ul class="boards">
      {boards.map(([k, label]) => (
        <li>
          <a href={`/rex/concept/${k}.webp`}>
            <img src={`/rex/concept/${k}-640.webp`} srcset={`/rex/concept/${k}-640.webp 640w, /rex/concept/${k}.webp 1536w`} sizes="(max-width: 760px) 50vw, 270px" width="640" height="427" loading="lazy" decoding="async" alt={`Earlier TinyRex concept board: ${label}`} />
          </a>
          <span>{label}</span>
        </li>
      ))}
    </ul>
    <p class="credit">Concept art: WCKD. Select any image for full size.</p>
  </section>

  <section id="current" aria-labelledby="current-title">
    <h2 id="current-title">the current build</h2>
    <p>What the agent has designed and verified so far, in Polykrom's lime and black: the design in the repository, the model you can turn below, and every number on this page.</p>

  <div class="media">
    <figure class="shot">
      <img src="/rex/render.png" width="800" height="1000" loading="lazy" decoding="async" alt="TinyRex standing, rendered in Polykrom: lime printed shells, black servos, an open jaw full of teeth and a spiked tail." />
      <figcaption>Rendered in Polykrom, from the agent's design.</figcaption>
    </figure>
    <figure class="shot shot--walk">
      <video src="/rex/walk.mp4" poster="/rex/walk-poster.jpg" width="480" height="600" autoplay muted loop playsinline controls preload="none" aria-label="TinyRex taking two steps in Polykrom's Walk study"></video>
      <figcaption>The Walk study: two 40 mm steps, the tail swinging to the stance side.</figcaption>
    </figure>
  </div>

  <p class="status"><span class="sq" aria-hidden="true"></span><strong>Status.</strong> The agent is restyling the CAD model to the concept above, and the rebuild on <a href="https://github.com/wckdboy/polycore" rel="noopener">PolyCore</a> is in progress; the design and the numbers here will change.</p>
  </section>

  <section id="model" aria-labelledby="model-title">
    <div class="section-head"><h2 id="model-title">the model</h2><p class="label">drag to turn</p></div>
    <div class="stage-frame">
      <div id="stage" class="stage"><p id="loading" class="loading">Loading the 3D model…</p></div>
      <div class="controls">
        <button id="play" type="button" disabled>Pause</button>
        <input id="scrub" type="range" min="0" max="272" step="0.1" value="0" aria-label="Walk study step" disabled />
        <span class="step">step <span id="r-step">0</span></span>
      </div>
    </div>
    <p class="small">The agent's design, exported from Polykrom, playing its Walk study: 272 steps keyed only on the 17 joints. A motion study can't move a free body, so here the body is held still and the legs step under it; the walk with the body free is MuJoCo's, in the results below.</p>
  </section>

  <section id="specs" aria-labelledby="specs-title">
    <h2 id="specs-title">what it is today</h2>
    <div class="table-wrap">
      <table class="spec">
        <tbody>
          {specs.map(([k, v]) => (<tr><th scope="row">{k}</th><td>{v}</td></tr>))}
        </tbody>
      </table>
    </div>
  </section>

  <section id="results" aria-labelledby="results-title">
    <h2 id="results-title">what was verified</h2>
    <div class="tiles">
      {results.map(([n, t]) => (<div class="tile"><p class="n">{n}</p><p class="t">{t}</p></div>))}
    </div>
    <p class="note">The MuJoCo walk is being re-run with the corrected mass (<a href="https://github.com/wckdboy/polykrom/issues/238" rel="noopener">Polykrom #238</a>). The model it walked on was about 413 g light, because some printed parts exported as meshes with gaps (<a href="https://github.com/wckdboy/polykrom/issues/216" rel="noopener">#216</a>), so its servo loads read low. The Polykrom statics above use the full 1.68 kg.</p>
  </section>

  <section id="build" aria-labelledby="build-title">
    <h2 id="build-title">how it was built</h2>
    <p>An AI agent built TinyRex through Polykrom's MCP server, with Polykrom's tools as its only tools: no shell, no file access, no hand edits. The work was split into staged briefs. Each stage is a fresh headless Claude Code session that opens the design the stage before saved, does one job, verifies it and reports back. The briefs, the harness and every stage's report are <a href={REPO} rel="noopener">in the repository</a>.</p>
    <div class="table-wrap">
      <table class="stages">
        <thead><tr><th>Stage</th><th>What the agent did</th><th class="num">Tool calls</th><th class="num">Cost, USD</th></tr></thead>
        <tbody>
          {stages.map(([s, what, calls, cost]) => (<tr><td><strong>{s}</strong></td><td class="small">{what}</td><td class="num">{calls}</td><td class="num">{cost}</td></tr>))}
        </tbody>
      </table>
    </div>
    <p class="small">Stage 4 ran in two sessions (69 and 150 tool calls): the first hit a usage limit, the second the harness's three-hour timeout after saving its work, so only the first session's cost was recorded. Stage 5 checked what it left and repaired it.</p>
  </section>

  <section id="get" aria-labelledby="get-title">
    <h2 id="get-title">get it</h2>
    <ul class="links">
      <li><a href={`${REPO}/blob/main/results/rex-bom.csv`} rel="noopener">Bill of materials</a><span>CSV: 71 rows covering all 163 parts</span></li>
      <li><a href={REPO} rel="noopener">github.com/wckdboy/tinyrex</a><span>the design, the briefs, the harness and the stage reports</span></li>
      <li><a href="https://cad.polykrom.app" rel="noopener">Polykrom</a><span>the CAD it was built in, in the browser (<a href="https://github.com/wckdboy/polykrom" rel="noopener">source</a>)</span></li>
      <li><a href="https://github.com/wckdboy/polycore" rel="noopener">PolyCore</a><span>the Rust geometry kernel TinyRex will be rebuilt on</span></li>
    </ul>
    <p class="small">Code is Apache-2.0; the CAD design, its renders and animation are CC-BY-4.0. Concept art: WCKD. Feetech, Raspberry Pi and MuJoCo are named for what they are; none of them is affiliated with TinyRex.</p>
  </section>

  <script type="importmap" is:inline>
  {"imports": {"three": "/rex/vendor/three.module.min.js", "three/addons/": "/rex/vendor/"}}
  </script>
  <script type="module" is:inline>
  import { mount } from "/rex/viewer.js";
  const $ = (id) => document.getElementById(id);
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) document.querySelector(".shot--walk video")?.pause();
  // Every part keeps the colour the agent gave it in Polykrom (it travels in the URDF); printed
  // parts (lime, black, off-white) get a matte plastic finish, like the Polykrom showcases.
  async function printedLooks(url) {
    const xml = new DOMParser().parseFromString(await (await get(url)).text(), "application/xml");
    if (xml.querySelector("parsererror") || !xml.querySelector("robot > link")) throw new Error(`${url}: not a robot description`);
    const matte = { "0.8 1 0": "#CCFF00", "0.067 0.067 0.067": "#111111", "0.929 0.929 0.929": "#EDEDED" };
    const looks = {};
    for (const link of xml.querySelectorAll("robot > link")) {
      const c = link.querySelector("visual material color");
      if (!c) continue;
      const key = c.getAttribute("rgba").trim().split(/\s+/).slice(0, 3).map((v) => +(+v).toFixed(3)).join(" ");
      if (matte[key]) looks[link.getAttribute("name")] = { color: matte[key], metalness: 0.05, roughness: 0.55 };
    }
    return looks;
  }
  async function get(url, opts) {
    const res = await fetch(url, opts);
    if (!res.ok) throw new Error(`${url}: HTTP ${res.status}`);
    return res;
  }
  async function gunzip(url) {
    const res = await get(url);
    return await new Response(res.body.pipeThrough(new DecompressionStream("gzip"))).arrayBuffer();
  }
  try {
    // The viewer's own fetches don't check the status: check every file first, so a missing one
  // shows the message below rather than an empty stage.
  const motion = await (await get("/rex/model/motion.json")).json();
  await get("/rex/model/meshes.json", { method: "HEAD" });
  const looks = await printedLooks("/rex/model/rex.urdf");
    const bin = await gunzip("/rex/model/meshes.bin.gz");
    let scrubbing = false;
    const narrow = $("stage").clientWidth < 1.1 * $("stage").clientHeight;
    const v = await mount($("stage"), {
      urdf: "/rex/model/rex.urdf", motion, pack: { bin, json: "/rex/model/meshes.json" }, colors: looks, theme: "ink",
      camera: { position: [0.95, -1.1, 0.58].map((c) => c * (narrow ? 1.2 : 1)), target: [0.02, 0, 0.25] },
      onStep(s) {
        if (!scrubbing) $("scrub").value = s;
        $("r-step").textContent = Math.round(s);
      },
    });
    $("loading").remove();
  // Horizontal drags turn the model; vertical swipes still scroll the page on a phone.
  const canvas = $("stage").querySelector("canvas");
  if (canvas) canvas.style.touchAction = "pan-y";
    $("scrub").max = v.steps;
    $("play").disabled = false;
    $("scrub").disabled = false;
    const label = () => { $("play").textContent = v.playing ? "Pause" : "Play"; };
    label();
    $("play").onclick = () => { v.play(!v.playing); label(); };
    $("scrub").oninput = (e) => { scrubbing = true; v.play(false); label(); v.seek(+e.target.value); scrubbing = false; };
  } catch (e) {
    $("loading").textContent = "The 3D view couldn't load here (it needs WebGL and a current browser). The render and the walk above show the same design.";
    console.error(e);
  }
  </script>
</Lab>


<style>
  .hero {
    --lime: #ccff00;
    --bone: #efeae2;
    --ash: #8e8a84;
    --ink-rule: #2f2d2a;
    background: #111111;
    color: var(--bone);
    padding: 44px 44px 36px;
    margin: 0 0 18px;
    border: 1px solid #111111;
  }
  .kicker {
    font-size: 12px;
    color: var(--ash);
    margin: 0 0 22px;
  }
  .word {
    margin: 0 0 26px;
    color: var(--lime);
    line-height: 0;
  }
  .word::after { display: none; }
  .word :global(svg) {
    display: block;
    width: min(100%, 620px);
    height: auto;
  }
  .pitch {
    font-size: 18px;
    line-height: 1.55;
    max-width: 46ch;
    margin: 0 0 30px;
    color: var(--bone);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--ink-rule);
    border-bottom: 1px solid var(--ink-rule);
    margin: 0 0 26px;
  }
  .stats > div {
    padding: 14px 16px 14px 0;
    border-right: 1px solid var(--ink-rule);
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
  }
  .stats > div:last-child { border-right: 0; }
  .stats dd {
    margin: 0 0 4px;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--bone);
  }
  .stats dt {
    font-size: 12px;
    color: var(--ash);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    font-size: 14px;
  }
  .hero-actions a {
    color: var(--bone);
    text-decoration: underline;
    text-decoration-color: var(--lime);
    text-underline-offset: 4px;
  }
  .hero-actions a.cta {
    background: var(--lime);
    color: #111111;
    text-decoration: none;
    font-weight: 700;
    padding: 11px 16px;
  }
  .hero-actions a.cta:hover { background: var(--bone); }
  .hero :focus-visible { outline-color: var(--lime); }

  .stats-label {
    font-size: 12px;
    color: var(--ash);
    margin: 0 0 8px;
  }
  .concept-hero {
    margin: 30px -44px -36px;
  }
  .concept-hero > a {
    display: block;
    background: #f7f2ec;
  }
  .concept-hero img {
    display: block;
    width: 100%;
    height: auto;
  }
  .concept-hero figcaption {
    background: transparent;
    color: var(--ash);
    font-size: 12px;
    padding: 10px 44px 12px;
    border-top: 1px solid var(--ink-rule);
  }
  .concept-hero figcaption a { color: var(--bone); text-decoration-color: var(--lime); }

  .views,
  .boards {
    list-style: none;
    padding: 0;
    margin: 18px 0 0;
    display: grid;
    gap: 12px;
  }
