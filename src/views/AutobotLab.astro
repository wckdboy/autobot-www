---
import Lab from '../layouts/Lab.astro';
import AutobotTerm from '../components/AutobotTerm.astro';
import { releases } from '../data/site';
import { fmtBytes, fmtDate, v } from '../lib/format';

const latest = releases.autobot.latest;
const apk = latest.assets.find((a) => /release\.apk$/.test(a.name));
const status = [
  ['Android', 'shipping', 'signed APK, Android 14+, arm64'],
  ['iOS', 'TestFlight', 'same version as Android'],
  ['Terminal', 'shipping', 'macOS and Linux, with Invincible'],
  ['Snapdragon NPU / GPU', 'verified', 'OnePlus 15, 8 Elite Gen 5'],
  ['Security review', 'not independent yet', 'signed, hashes published'],
];
---
<Lab path="/" current="overview" description="Private AI on your phone. Chat, agents, images and voice run on the device, offline by default.">
  <h1>autobot</h1>
  <p class="lede">Private AI on your phone. Chat, agents, images and voice run on the device, offline by default.</p>

  <div class="actions">
    <a class="button button--primary" href={apk?.url} download>Download {v(latest.tag)}</a>
    <a class="text-link" href="/install/">Install</a>
    <a class="text-link" href="https://github.com/wckdboy/autobot" rel="noopener">Source</a>
  </div>

  <dl class="facts">
    <div><dt>Release</dt><dd>v{v(latest.tag)} · {fmtDate(latest.published)}</dd></div>
    <div><dt>Platforms</dt><dd>Android 14+, iOS 18+</dd></div>
    <div><dt>License</dt><dd>Apache-2.0</dd></div>
    <div><dt>Network</dt><dd>Offline by default</dd></div>
    <div><dt>Telemetry</dt><dd>None</dd></div>
    <div><dt>Size</dt><dd>{apk ? fmtBytes(apk.size) : '—'}</dd></div>
  </dl>

  <section id="terminal">
    <h2>On your machine</h2>
    <p>The same agent in your terminal on macOS and Linux, through Invincible.</p>
    <pre><code>curl -fsSL https://invincible.sh/install.sh | sh
autobot code</code></pre>
    <AutobotTerm />
  </section>

  <section id="status">
    <h2>Status</h2>
    <div class="table-wrap">
      <table>
        <tbody>{status.map(([part, state, note]) => (<tr><td><strong>{part}</strong></td><td>{state}</td><td class="small">{note}</td></tr>))}</tbody>
      </table>
    </div>
  </section>
</Lab>
