---
import Lab from '../layouts/Lab.astro';
import AutobotTerm from '../components/AutobotTerm.astro';
import { releases } from '../data/site';
import { fmtBytes, fmtDate, v } from '../lib/format';

const latest = releases.autobot.latest;
const apk = latest.assets.find((a) => /release\.apk$/.test(a.name));
const status = [
  ['Android', 'shipping', 'signed APK, Android 14+, arm64; Material 3 Expressive, rail and two panes on tablets'],
  ['iOS', 'TestFlight', 'same version as Android; the system look with Liquid Glass, sidebar and split chat on iPad'],
  ['Generative UI', 'shipping', 'the on-device agent shows forms and choices in phone chats (A2UI v1.0); off in Settings'],
  ['Terminal', 'shipping', 'macOS and Linux, with Invincible'],
  ['Bots', 'shipping', 'your node\'s bots on the phone: channels, approvals, on/off'],
  ['Harness (iOS)', 'experimental', 'the DeepSeek Harness itself, in a Linux guest on the phone; Offline stops it, the audit log records it; boots in about a minute'],
  ['Snapdragon NPU / GPU', 'partly measured', 'OnePlus 15 (8 Elite Gen 5): chat on the CPU and NPU, SDXL on the NPU; the GPU, SD 1.5 on the NPU and the upscaler not shown yet'],
  ['Security review', 'not independent yet', 'signed, hashes published'],
];
---
<Lab path="/" current="overview" description="Private AI on your phone. Chat, agents, images and voice run on the device, offline by default.">
  <h1>autobot</h1>
  <p class="lede">Private AI on your phone. Chat, agents, images and voice run on the device, offline by default.</p>

  <div class="actions">
    <a class="button button--primary" href={apk?.url} download>Download {v(latest.tag)}</a>
    <a class="text-link" href="/install/">Install</a>
    <a class="text-link" href="https://github.com/wckdboy/autobot" rel="noopener">Source</a>
  </div>

  <dl class="facts">
    <div><dt>Release</dt><dd>v{v(latest.tag)} · {fmtDate(latest.published)}</dd></div>
    <div><dt>Platforms</dt><dd>Android 14+, iOS 18+</dd></div>
    <div><dt>License</dt><dd>Apache-2.0 · the iOS build GPL-3.0 · the Android build contains Qualcomm’s proprietary QNN runtime</dd></div>
    <div><dt>Network</dt><dd>Offline by default</dd></div>
    <div><dt>Telemetry</dt><dd>None</dd></div>
    <div><dt>Size</dt><dd>{apk ? fmtBytes(apk.size) : '—'}</dd></div>
  </dl>

  <section id="terminal">
    <h2>On your machine</h2>
    <p>Autobot’s agent in your terminal on macOS and Linux, through Invincible.</p>
    <pre><code>curl -fsSL https://invincible.sh/install.sh | sh
autobot code</code></pre>
    <AutobotTerm />
    <p class="small">It reads your project's AGENTS.md or CLAUDE.md, recalls earlier conversations with /recall, can speak or draw through your node's own backends, and works inside Zed with <code>autobot acp</code>.</p>
  </section>

  <section id="status">
    <h2>Status</h2>
    <div class="table-wrap">
      <table>
        <tbody>{status.map(([part, state, note]) => (<tr><td><strong>{part}</strong></td><td>{state}</td><td class="small">{note}</td></tr>))}</tbody>
      </table>
    </div>
  </section>
</Lab>
