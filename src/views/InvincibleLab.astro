---
import Lab from '../layouts/Lab.astro';
import AutobotTerm from '../components/AutobotTerm.astro';
import { releases } from '../data/site';
import { NAV } from '../data/nav';
import { fmtDate, v } from '../lib/format';

const latest = releases.invincible.latest;
const n = NAV.invincible;

const models = [
  ['Text', 'working', 'open models through llama.cpp, Metal on Apple silicon and CUDA on NVIDIA; one engine, one model format on every node'],
  ['Speech', 'working', 'in through whisper.cpp or any server in the OpenAI shape; out through Kokoro; your own backends first, cloud only when allowed'],
  ['Images', 'working', 'through your own image backends; delivered as files on every channel, with receipts'],
  ['Video', 'planned', 'the same route and receipt rules; no engine wired yet'],
  ['Frontier models', 'working', 'only when you allow it, redacted before they leave, every call signed'],
];

const cluster = [
  ['1 · two paired nodes', 'in progress', 'one model split across two nodes: llama.cpp RPC inside Noise shard links'],
  ['2 · real machines', 'planned', 'mDNS discovery, calibration, speed-aware plans, local weights; the installer ships the RPC server'],
  ['3 · resilience', 'planned', 'resume after a reshard, relaunch when a peer returns, micro-batched prefill'],
  ['4 · placement', 'planned', 'whole model on a peer, or split; the router picks head, peer or split per request'],
  ['5 · wired fast paths', 'planned', 'tensor parallel over 10 GbE and opt-in RDMA between machines you own'],
  ['6 · phones as shards', 'deferred', 'phones and tablets are clients of a node, not nodes: iOS cannot start an engine process, and a phone could serve only while awake, plugged in and cool'],
];

const training = [
  ['T1 · one device', 'planned', 'invincible train: LoRA fine-tuning on this node, datasets as files, adapters as models, an eval gate before an adapter is served'],
  ['T2 · across devices', 'planned', 'data-parallel LoRA on the machines you own, DiLoCo-style outer steps so a slow link does not stall the run'],
  ['T3 · with phones', 'deferred', 'federated LoRA, each phone training on its own data; phones and tablets are clients of a node, not nodes, so it has no device to run on for now'],
  ['T4 · larger runs', 'planned', 'pipeline-parallel training across machines, DeMo compression on the wire'],
];

const plain = [
  ['Serve a model', 'curl … | sh, then autobot setup. The node finds the fastest backend it has and answers on one endpoint for every device you own.'],
  ['Know what it costs you', 'every call has a receipt: model, route, tokens, redactions, signature. The audit log is a file you can read.'],
  ['Measure before believing', 'invincible eval runs your own tasks against a local model and a frontier one, keeps every run, and shows the gap as a number over time.'],
  ['Run a model bigger than one box', 'pair a second machine; the node splits the model and the router picks where a request goes. (Phase 1, in progress.)'],
  ['Teach it your work', 'the frontier model\'s runs become a local model\'s training data, with the eval gate deciding whether the adapter ships. (Planned.)'],
  ['Deploy at scale', 'the same binary from one laptop to a rack: static, reproducible, attested, always on, with health alerts to your chat.'],
];

const status = [
  ['Gateway', 'working', 'OpenAI- and Anthropic-compatible APIs; every request through the routing rules (51 conformance vectors)'],
  ['Receipts and audit log', 'working', 'signed, hash-chained'],
  ['Pairing', 'working, not reviewed', 'Noise'],
  ['Platforms', 'Linux, macOS', 'static, reproducible binaries with build attestations; Windows (x86_64, arm64) planned'],
  ['Auto-tune', 'planned', 'the node measures its own hardware and picks the layers, context and batch that run fastest; today the benchmarks run on demand'],
  ['Cluster', 'phase 1 in progress', 'see above'],
  ['Training', 'planned', 'see above: LoRA on one device, then across devices, then larger runs; federated training with phones is deferred'],
  ['Always on', 'working', 'launchd or systemd, health checks, self-update; Tor and SOCKS5 with the kill switch as a shared, tested rule; stopping leaves nothing running'],
  ['Agent', 'working', 'retries on provider errors, long turns kept within the context, loop detection, forgiving edits'],
  ['Bots and channels', 'working', 'Telegram, Discord, Slack, Email, Signal, Matrix, WhatsApp, Home Assistant'],
  ['Backups and alerts', 'working', 'one-file backups with checksums, scheduled; crashes, outages and failed tasks sent to your chat'],
  ['Control panel', 'working (alpha)', 'a versioned live turn (text, reasoning, tools, diffs, approvals), workspaces with a worktree per thread, bots, connectors, usage and settings in one authenticated surface; scrypt, signed sessions, CSRF, CSP; no provider keys in the browser'],
  ['Security review', 'not independent yet', 'fixes from an internal review are in'],
];
---
<Lab path="/" current="overview" nav={[...n.nav]} footerNote={n.footer} description="The node you own: one gateway for every model you run, on the hardware you have, across the machines you own, with frontier models only when you allow it and a signed receipt for every call.">
  <h1>invincible</h1>
  <p class="lede">The node you own. One gateway for every model you run: text, speech and images today, video next, on the hardware you have, across the machines you own; training to make them yours is planned. Frontier models only when you allow it, a signed receipt for every call, and the hard parts of AI made plain.</p>

  <pre><code>curl -fsSL https://invincible.sh/install.sh | sh
autobot setup</code></pre>

  <div class="actions">
    <a class="button button--primary" href="/install/">Install</a>
    <a class="text-link" href="/releases/">Releases</a>
    <a class="text-link" href={n.repo} rel="noopener">Source</a>
  </div>

  <dl class="facts">
    <div><dt>Release</dt><dd>v{v(latest.tag)} · {fmtDate(latest.published)}</dd></div>
    <div><dt>Platforms</dt><dd>Linux, macOS</dd></div>
    <div><dt>License</dt><dd>MIT</dd></div>
    <div><dt>Engine</dt><dd>llama.cpp · Metal, CUDA</dd></div>
    <div><dt>Telemetry</dt><dd>none</dd></div>
  </dl>

  <section id="why">
    <h2>What it is for</h2>
    <p>Capable AI is something you rent. The company, or the country it sits in, can change the price, the model or the terms, read what you send, or switch you off. Open-weight models and cheap accelerators make another path possible, but running them well is still a weekend of glue per machine, and nothing ties them into the tools people use.</p>
    <p>Invincible is that glue, with sovereignty as the design rule. One node on a desktop, a GPU box or a server gives every device you own one endpoint for intelligence. It runs open models itself, reaches frontier models only by your policy, keeps working when they are gone, and is Autobot's backend: the phone pairs with it, and the terminal agent uses it as its only model provider.</p>
    <p class="small">Autobot is a separate product, not a feature of the node: the two are joined by one protocol, pairing, receipts and one endpoint for every device. The node can run the agent; the phone can drive the node. Neither owns the other.</p>
    <p class="small">The node is also the natural host for the rest of the stack's state, including the world layer while its shape is still open.</p>
    <p class="small">Reference points: <a href="https://github.com/exo-explore/exo" rel="noopener">exo</a> pools Macs and workstations into one inference cluster over Thunderbolt and 10 GbE; <a href="https://github.com/deepseek-ai" rel="noopener">DeepInfer</a>, open-sourced by DeepSeek on 20 October 2026, is the engine behind its production API, for one model on data-centre GPUs. Invincible sits between them: llama.cpp on the machines people have, paired and receipted, growing into a cluster of the machines you own.</p>
  </section>

  <section id="plain">
    <h2>The hard parts, made plain</h2>
    <p>Research, building and deployment of AI are hard mostly in the glue: drivers and quantizations, which layers fit where, what a run cost, whether the new adapter is actually better. Invincible takes each of those and gives it one command, plain words and a number you can check. Where it cannot yet, it says so.</p>
    <div class="table-wrap">
      <table>
        <tbody>{plain.map(([task, how]) => (<tr><td><strong>{task}</strong></td><td class="small">{how}</td></tr>))}</tbody>
      </table>
    </div>
  </section>

  <section id="models">
    <h2>Every kind of model</h2>
    <div class="table-wrap">
      <table>
        <tbody>{models.map(([part, state, note]) => (<tr><td><strong>{part}</strong></td><td>{state}</td><td class="small">{note}</td></tr>))}</tbody>
      </table>
    </div>
    <p class="small">One rule for all of them: your own backend first, the cloud only when the route allows it, a receipt either way.</p>
  </section>

  <section id="cluster">
    <h2>Many nodes, one model</h2>
    <p>A model too large for one machine runs across the machines you own: the desktop, the GPU box, the laptop. Pairing, receipts and the audit log already exist for one node; the cluster reuses them. The plan, in the order it ships:</p>
    <div class="table-wrap">
      <table>
        <tbody>{cluster.map(([part, state, note]) => (<tr><td><strong>{part}</strong></td><td>{state}</td><td class="small">{note}</td></tr>))}</tbody>
      </table>
    </div>
    <p class="small">Nothing here is faster than one machine yet. Phase 1 is being built; the numbers will be published with it.</p>
  </section>

  <section id="training">
    <h2>Decentralized fine-tuning and training</h2>
    <p>The plan: the same cluster that serves a model trains one. Fine-tuning starts on one node with your own data and an eval gate, then grows across the machines you own. Every stage is a LoRA adapter the node serves like any model, and every run is kept with its numbers.</p>
    <div class="table-wrap">
      <table>
        <tbody>{training.map(([part, state, note]) => (<tr><td><strong>{part}</strong></td><td>{state}</td><td class="small">{note}</td></tr>))}</tbody>
      </table>
    </div>
    <p class="small">What exists today is the feed: the evals keep every frontier and local run, so a frontier model's work on your tasks is already a local model's training set in waiting. The trainer itself is planned; nothing on this table ships yet.</p>
  </section>

  <section id="rules">
    <h2>Security, speed, anonymity, stability</h2>
    <ul>
      <li><strong>Security.</strong> Devices pair over Noise; personal data is redacted before anything leaves; every request gets a signed receipt and a line in a hash-chained audit log; releases are reproducible, attested and signed with a pinned key. The independent review is still to come.</li>
      <li><strong>Speed.</strong> One engine and one model format on every node, on the fastest backend the machine has; speculative decoding and the auto-tune are next. Every night, benchmarks time the gateway and the agent against stand-in models and report binary sizes; the numbers are in that night's CI summary, not kept as a history.</li>
      <li><strong>Anonymity.</strong> Offline by default; Tor and SOCKS5 as routes with the kill switch as a shared, tested rule; no accounts, no telemetry, nothing phones home.</li>
      <li><strong>Stability.</strong> Always on under launchd or systemd with health checks and self-update; a ten-minute soak test every night; backups in one file; stopping leaves nothing running; it tells your chat when something breaks.</li>
    </ul>
  </section>

  <section id="code">
    <h2>Code with Autobot</h2>
    <pre><code>autobot code --model anthropic</code></pre>
    <AutobotTerm />
    <p class="small">Inline, keeps your scrollback. Enter sends, / opens commands, @ attaches a file, ctrl+r searches, a pasted or dragged image goes along to models that can see, esc interrupts; y, a, n or e (no, and say what instead) answers an approval. A coding session starts with a compact map of the project — directories, key files and their top-level symbols — built from the files git tracks, so a local model can find its way without spending its context on a tree. It works in a tight loop: read once, make the smallest change, run the relevant test once, and stop when it passes. After a turn, <code>autobot review</code> sends the diff to a separate read-only reviewer; <code>--model</code> picks a second model through the gateway. <code>--approvals auto</code> lets commands and project changes run without asking, while network and reads outside the project still ask. In Zed or another ACP editor, add <code>autobot acp</code> as an agent server: commands run in Zed's terminal, Zed's MCP servers join Autobot's, and the model, the approval mode and the slash commands are in Zed's menus.</p>
    <pre><code>autobot thread start --name "fix checkout"   # a worktree and branch of its own
autobot thread diff t-… --stat
autobot thread pr t-… --title "Fix checkout" # gh, GH_TOKEN or a compare link</code></pre>
    <p class="small">A thread is a conversation with its own checkout: two agents can work in parallel without touching each other's files. A removed thread leaves a tombstone, so its old session cannot fall back to the main checkout. <code>thread pr</code> commits, pushes and opens the pull request with <code>gh</code>, the GitHub API and <code>GH_TOKEN</code>, or returns the compare link after the push.</p>
    <p class="small">Autobot is compared with other coding agents by what they leave behind, not by a model's opinion: <code>evals/harness</code> runs Claude Code, Codex, Hermes Agent, OpenCode, Pi and Autobot in fresh directories on the same tasks, then checks exact file bytes, tests and untouched files. Every run is kept, so a harness change — including a Harness²-style evolved one — is measured on the same suite before it ships.</p>
  </section>

  <section id="bots">
    <h2>Bots</h2>
    <p>Several agents on one node, each with its own persona, model, memory and channels. One <code>autobot serve</code> runs them all, around the clock, and picks up a new or changed bot without a restart.</p>
    <pre><code>autobot bots add ops            # asks for the persona, model and channels
autobot identities link telegram:123 slack:U456
autobot service status</code></pre>
    <p>Left to run for months, it tells you when something goes wrong: a crash, the gateway or a model gone, a full disk, a failed task or backup, an update. Alerts go to your home chat, at most so many an hour, held through quiet hours.</p>
    <pre><code>autobot backup                  # the whole agent in one .tar.gz, secrets left out
autobot restore backup.tar.gz   # checks every file, shows what changes, keeps the old home
autobot alerts test
autobot logs agent --follow</code></pre>
  </section>

  <section id="agent">
    <h2>Set it up from the terminal</h2>
    <p>Turn tools on and off, change a setting and pick a model without opening a file. Ask about an old conversation, and find and review a skill before you install it.</p>
    <pre><code>autobot tools disable browser --bot ops
autobot config set agent.recall_model off
autobot model
autobot skills search pdf
autobot skills install pdf      # shows the source and SKILL.md, then asks
autobot skills check            # updates, and skills edited locally
autobot skills audit pdf        # risky scripts, and how far the source is trusted</code></pre>
    <p class="small">In a chat, <code>/recall</code> searches every earlier conversation and <code>/context</code> lists the instructions in play, from AGENTS.md, CLAUDE.md and the rest. A file that looks like a prompt injection is quoted to the model as data, with a warning.</p>
  </section>

  <section id="panel">
    <h2>The control panel</h2>
    <p>The node and the agent share one operator surface: a zero-dependency Node panel with a scrypt password, signed HttpOnly SameSite=Strict sessions, CSRF tokens, login rate limiting and a strict CSP. Its rooms are Overview, Chat, Workspaces, Bots, Integrations, Usage and Settings: gateway health, a versioned live turn that streams text, reasoning, tool output, diffs and approval cards as they happen, a thread's worktree, diff and pull request, bots to add and switch on, a connector matrix with write-only token files, today's tokens and cost, the gateway audit, and the model, approvals and tool groups with any advanced key.</p>
    <p class="small">The panel never holds provider keys. The browser talks only to the panel; the panel proxies the gateway and agent calls it needs with the node's token, and the node keeps every key, policy decision and receipt. The alpha stack runs the panel, the agent and a cloud-only gateway on one host behind Coolify's Traefik; the same services ship as a Docker Compose with Caddy on a host that runs Invincible. The panel is password-protected; the <a href="https://github.com/WCKDai/platform/tree/main/services/agent" rel="noopener">deployment runbook and security model</a> are public.</p>
  </section>

  <section id="status">
    <h2>Status</h2>
    <div class="table-wrap">
      <table>
        <tbody>{status.map(([part, state, note]) => (<tr><td><strong>{part}</strong></td><td>{state}</td><td class="small">{note}</td></tr>))}</tbody>
      </table>
    </div>
  </section>
</Lab>
