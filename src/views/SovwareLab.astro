---
import Lab from '../layouts/Lab.astro';
import { releases } from '../data/site';
import { kit, symbolSvg } from '../data/kit';
import { fmtDate, v } from '../lib/format';

const a = releases.autobot.latest;
const i = releases.invincible.latest;
const products = ['autobot', 'invincible', 'omnie', 'nightfall'].map((k) => ({ key: k, ...kit.brands[k] }));
const state: Record<string, string> = {
  autobot: `v${v(a.tag)} · ${fmtDate(a.published)} · Android and iOS`,
  invincible: `v${v(i.tag)} · ${fmtDate(i.published)} · Linux and macOS`,
  omnie: 'iPhone, Mac and Vision Pro · in development',
  nightfall: 'macOS · visual development preview',
};
---
<Lab path="/" current="" description="Sovereign hardware and software, made by WCKD.">
  <h1>sovware</h1>
  <p class="lede">Sovereign hardware and software.</p>

  <section>
    <div class="table-wrap">
      <table>
        <tbody>
          {products.map((p) => (
            <tr>
              <td style="width:32px"><span style={`color:${p.onPaper};display:block`} set:html={symbolSvg(p, 18, p.name)} /></td>
              <td><strong><a href={`https://${p.domain}`} rel="noopener">{p.name.toLowerCase()}</a></strong></td>
              <td>{p.role}</td>
              <td class="small">{state[p.key]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <p class="small">boy@wckd.cc · <a href="https://github.com/wckdboy" rel="noopener">github</a></p>
</Lab>
