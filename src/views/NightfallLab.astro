---
import Lab from '../layouts/Lab.astro';

const next = [
  ['Polykrom', 'the app: open-source parametric CAD in Rust, a fork of SolidCraft, with stress analysis and an AI companion. It runs in the browser at cad.polykrom.app', 'https://polykrom.app'],
  ['PolyCore', 'the kernel: an Apache-2.0 geometry kernel in Rust, carrying on Nightfall\'s kernel work', 'https://github.com/wckdboy/polycore'],
];

const carried = [
  ['NURBS math', 'Nightfall\'s Rust NURBS curves and surfaces, with their derivatives'],
  ['Studies', 'the structural and thermal study pipeline and its reference cases, checked against theory'],
  ['Kernel rubric', 'the bake-off rubric that chose Nightfall\'s kernel on a 20-part corpus and 200 ABC models, to judge PolyCore by'],
  ['Agent evaluation', 'the harness in which an agent builds, edits and repairs every reference part, measured against the exact part'],
];
---

<Lab
  path="/"
  current="overview"
  og="/og/nightfall.png"
  description="Nightfall is archived. Development continues as Polykrom, the app, and PolyCore, the kernel."
>
  <h1>nightfall</h1>
  <p class="lede">Nightfall is archived. Development continues as <a href="https://polykrom.app" rel="noopener">Polykrom</a>, the app, and <a href="https://github.com/wckdboy/polycore" rel="noopener">PolyCore</a>, the kernel.</p>

  <div class="actions">
    <a class="button button--primary" href="https://polykrom.app" rel="noopener">Polykrom</a>
    <a class="text-link" href="https://github.com/wckdboy/polycore" rel="noopener">PolyCore</a>
    <a class="text-link" href="https://github.com/wckdboy/nightfall" rel="noopener">Nightfall source (archived)</a>
  </div>

  <dl class="facts">
    <div><dt>State</dt><dd>archived</dd></div>
    <div><dt>App</dt><dd>Polykrom</dd></div>
    <div><dt>Kernel</dt><dd>PolyCore</dd></div>
  </dl>

  <section id="next">
    <h2>Where it went</h2>
    <div class="table-wrap">
      <table>
        <tbody>
          {next.map(([name, what, href]) => (
            <tr><td><strong><a href={href} rel="noopener">{name}</a></strong></td><td class="small">{what}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section id="carried">
    <h2>What carries over</h2>
    <div class="table-wrap">
      <table>
        <tbody>
          {carried.map(([area, what]) => (
            <tr><td><strong>{area}</strong></td><td class="small">{what}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="small">The Nightfall repository stays public as a record and is no longer developed.</p>
  </section>
</Lab>
