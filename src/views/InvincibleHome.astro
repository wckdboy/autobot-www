---
import Base from '../layouts/Base.astro';
import Signal from '../components/Signal.astro';
import Ticker from '../components/Ticker.astro';
import SectionHead from '../components/SectionHead.astro';
import Terminal from '../components/Terminal.astro';
import Releases from '../components/Releases.astro';
import Icon from '../components/Icon.astro';
import { releases, meta, install } from '../data/site';
import { fmtDate, fmtBytes, v } from '../lib/format';

const latest = releases.invincible.latest;
const mac = latest.assets.find((a) => /macos/.test(a.name));
const linux = latest.assets.find((a) => /linux-x64/.test(a.name));
const sums = latest.assets.find((a) => a.name === 'SHA256SUMS');
const sig = latest.assets.find((a) => a.name.endsWith('.sig'));

const tiers = [
  {
    n: '01',
    name: 'This phone',
    owner: 'You',
    built: 'Autobot · shipping',
    body: 'Snapdragon NPU, Adreno GPU, Apple Metal and the Neural Engine. No network needed. The first tier already works.',
    active: false,
  },
  {
    n: '02',
    name: 'My node',
    owner: 'You',
    built: 'Invincible · early build',
    body: 'Your desktop, GPU box or a rack in your hackerspace. Stronger open models, agents that never sleep, your rules.',
    active: true,
  },
  {
    n: '03',
    name: 'Our region',
    owner: 'Your community',
    built: 'Invincible · later',
    body: 'Pooled nodes of people you trust: a co-op, a city, a country. Federation is designed, not shipped.',
    active: false,
  },
  {
    n: '04',
    name: 'Cloud',
    owner: 'Someone else',
    built: 'Their APIs',
    body: 'Frontier models are welcome here. Being dependent on them is not. They are optional, redacted and receipted.',
    active: false,
  },
];

const does = [
  ['01', 'Serves open models', 'Pulls open weights, verifies them by hash, picks an engine for the hardware and serves them. One command per model.'],
  ['02', 'Speaks the standard APIs', 'OpenAI-compatible and Anthropic-compatible endpoints, so any tool works by changing one URL. Autobot gets a richer native protocol.'],
  ['03', 'Routes by policy', 'Rules decide where each request runs: private never leaves hardware you own; planning can go to frontier; a dead cloud falls back to local. Local is the default.'],
  ['04', 'Runs agents that never sleep', 'Headless agent sessions with no battery, no background limit and the whole GPU. Long recipes, overnight jobs, work while the phone is off.'],
  ['05', 'Measures the gap', 'An eval harness replays real tasks against every model on every tier. “How close is open to frontier” becomes a number you track.'],
  ['06', 'Keeps the records you own', 'Every request, route, model, token count and cost in an encrypted local log, hash-chained and checkable. Nothing is reported anywhere.'],
];

const setup = [
  ['Network', 'offline, direct, or Tor / SOCKS5 for the whole machine.'],
  ['Model', 'a Qwen open-weights model sized to this machine’s memory, or any hf: GGUF.'],
  ['Agent', 'its working directory, and whether turns stay on local models (the default).'],
  ['Telegram', 'optional: a bot token from @BotFather, approvals by button.'],
  ['Background', 'launchd on macOS, systemd user units on Linux — with linger on a VPS.'],
];
---
<Base path="/">
  <section class="hero">
    <div class="shell">
      <div class="hero__grid">
        <div class="hero__copy">
          <div class="hero__kicker">
            <span class="eyebrow">Self-hosted AI node · MIT</span>
            <span class="pill pill--red">Latest v{v(latest.tag)}</span>
          </div>
          <h1>
            <span class="line outline">Borrowed</span>
            <span class="line">Intelligence</span>
            <span class="line accent">is not yours.</span>
          </h1>
          <div class="hero__sub">
            <p>
              A node you own. Install it on a desktop, GPU box or VPS; it serves open models behind
              standard APIs, reaches frontier models <b>only when your rules allow</b>, signs a
              receipt for every request, and keeps working when the cloud is gone.
            </p>
            <div class="signature" aria-hidden="true" style="font:500 8.5px/1.6 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--muted);text-align:right;white-space:nowrap">
              NO ACCOUNTS<br />NO RELAY<br />NO TELEMETRY
            </div>
          </div>
          <div class="hero__actions">
            <a class="btn" href="#install">Install the node</a>
            <a class="btn btn--ghost" href="#tiers">See the tiers <span class="btn__arrow">↓</span></a>
            <a class="btn btn--ghost hide-mobile" href={meta.repo} rel="noopener">
              <Icon name="github" size={13} /> Source
            </a>
          </div>
          <div class="hero__meta">
            <span>macOS arm64</span>
            <span>Linux x64 / arm64</span>
            <span><i class="dot" style="width:5px;height:5px"></i> Local by default</span>
            <span>{mac ? `${fmtBytes(mac.size)} binary` : 'Static binary'}</span>
          </div>
        </div>

        <div class="hero__art">
          <div class="hero__side">
            <div style="position:relative">
              <Signal
                kind="globe"
                topLeft="Node / 01"
                topRight="Private"
                bottomLeft="0 bytes out"
                bottomRight="Local"
                label="One node · every device"
                aria="A halftone globe with nodes and signed routes, drawn live from dots"
              />
              <span class="stamp">No accounts</span>
            </div>
            <Terminal
              title="install · macOS / linux"
              command="curl -fsSL https://invincible.sh/install.sh | sh"
              lines={[
                { kind: 'dim', text: '# no root · installs invincible + autobot' },
                { kind: 'ok', text: '→ signed release · pinned key · reproducible' },
              ]}
              copyText="curl -fsSL https://invincible.sh/install.sh | sh"
            />
            <dl class="readouts">
              <div class="readout"><dt>Release</dt><dd>{v(latest.tag)}</dd></div>
              <div class="readout"><dt>Engine</dt><dd>Llama.cpp</dd></div>
              <div class="readout"><dt>Routing</dt><dd>Local first</dd></div>
              <div class="readout"><dt>Receipts</dt><dd class="red">Ed25519</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Ticker
    items={[
      'No accounts',
      'No relay',
      'No telemetry',
      'Local is the default',
      'Signed receipts',
      'OpenAI-compatible',
      'Anthropic-compatible',
      'Reproducible Linux builds',
      'Conformance vectors',
      'Hash-chained audit',
      'No vendor lock-in',
      'MIT',
    ]}
  />

  <section class="section section--tight" id="why">
    <div class="shell">
      <SectionHead num="01" label="Why">
        <Fragment slot="title">Capable AI is<br /><em>something you rent.</em></Fragment>
        <Fragment slot="note">
          A company, or the country it sits in, can change the price, the policy, the model or the
          terms, read what you send, or switch you off. Open weights and cheap accelerators make
          another path possible — but running them well is still a weekend of glue per machine.
        </Fragment>
      </SectionHead>

      <div class="split">
        <div class="split__aside">
          <div class="quote quote--small">
            Frontier models are welcome here. <em>Dependence is not.</em>
          </div>
          <p class="byline">Invincible · design rule</p>
          <div class="status-row">
            <span class="live">v{v(latest.tag)} shipped</span>
            <span>{fmtDate(latest.published)}</span>
          </div>
        </div>
        <div class="split__main">
          <div class="prose">
            <p>
              Today, capable AI is rented. The model, the weights, the data path and the off switch
              belong to someone else. Invincible is a <b>self-hosted node</b> that makes ownership
              practical: one binary, one command per model, and one endpoint for every device you
              own.
            </p>
            <p>
              It is built for <b>Autobot first</b>, and shares its rules instead of re-implementing
              them. Pairing is a QR code and a Noise handshake. The phone’s policy, redaction,
              receipts and kill switch continue to hold on the other end. The node adds what a phone
              cannot: a GPU, always-on sessions, and a machine you can unplug from the cloud.
            </p>
            <p>
              Everything works without a frontier provider. Frontier models make it faster when you
              choose to use them, through the same routing rules, the same redaction and the same
              signed record.
            </p>
          </div>
          <dl class="stats mt-4">
            <div class="stat"><dt>Binary</dt><dd>01<small>Static · Rust</small></dd></div>
            <div class="stat"><dt>Conformance</dt><dd>51<small>Routing vectors</small></dd></div>
            <div class="stat"><dt>Accounts</dt><dd>00<small>Keys, not logins</small></dd></div>
            <div class="stat"><dt>APIs</dt><dd>02<small>OpenAI · Anthropic</small></dd></div>
          </dl>
        </div>
      </div>

      <div class="scene-strip mt-4" data-reveal>
        <div><b>Local is the default</b><span>Leaving hardware you own is always a choice, visible and reversible.</span></div>
        <div><b>No phoning home</b><span>No telemetry, no update checks you did not ask for, no accounts.</span></div>
        <div><b>Frontier-optional</b><span>Every feature has a path without a third party. Frontier makes it faster, not possible.</span></div>
      </div>
    </div>
  </section>

  <section class="section section--rule" id="tiers">
    <div class="shell">
      <SectionHead num="02" label="The tiers">
        <Fragment slot="title">One interface.<br /><em>Four places to run.</em></Fragment>
        <Fragment slot="note">
          If a tier disappears, things get slower — nothing breaks. That is the whole point of
          owning the middle.
        </Fragment>
      </SectionHead>

      <div class="tiers">
        {tiers.map((t) => (
          <div class={t.active ? 'tier tier--active' : 'tier'} data-reveal>
            <span class="tier__pulse" aria-hidden="true"></span>
            <span class="tier__d">TIER {t.n}</span>
            <span class="tier__name">
              {t.name === 'My node' ? <>My <em>node</em></> : t.name}
            </span>
            <span class="tier__copy">{t.body}</span>
            <span class="tier__you">{t.active ? 'This project' : t.built}</span>
          </div>
        ))}
      </div>
      <p class="mono mt-3" style="font-size:9px;letter-spacing:.1em;color:var(--muted)">
        Owned by: you · you · your community · someone else. Built by: Autobot · Invincible · Invincible · their APIs.
      </p>
    </div>
  </section>

  <section class="section is-ink">
    <div class="shell">
      <SectionHead num="03" label="What a node does">
        <Fragment slot="title">The glue, with<br /><em>sovereignty as the rule.</em></Fragment>
        <Fragment slot="note">
          Not a chat UI. Not a training stack. The node is the thing that makes models useful on
          hardware you control — and keeps the receipt.
        </Fragment>
      </SectionHead>

      <div class="ledger">
        {does.map(([n, title, body]) => (
          <div class="ledger__row" data-reveal>
            <span class="ledger__n">{n}</span>
            <h3 class="ledger__t">{title}</h3>
            <p class="ledger__d">{body}</p>
          </div>
        ))}
      </div>

      <div class="split mt-4">
        <div class="split__aside">
          <div class="receipt" data-reveal>
            <div class="receipt__head"><span>Routing decision</span><span>REQ 7C1</span></div>
            <div class="receipt__row"><span>Request</span><b>invincible-private</b></div>
            <div class="receipt__row"><span>Route</span><b>Local · llama.cpp</b></div>
            <div class="receipt__row"><span>Cloud</span><b class="ok">Not eligible</b></div>
            <div class="receipt__row"><span>Egress</span><b>0 bytes</b></div>
            <div class="receipt__row"><span>Redacted</span><b>—</b></div>
            <div class="receipt__row"><span>Receipt</span><b>Ed25519 signed</b></div>
            <div class="receipt__foot"><span>Example</span><span>GET /v1/receipts/7C1</span></div>
          </div>
        </div>
        <div class="split__main">
          <p class="lede">
            The default is local. A request marked <code class="inline-code">invincible-private</code>
            is never eligible for the cloud. When something does leave, redaction runs first, the
            bytes are counted, and the receipt says exactly where it went.
          </p>
          <p class="mono mt-3" style="font-size:9px;line-height:1.9;letter-spacing:.09em;color:var(--muted)">
            OFFLINE · DIRECT · TOR · SOCKS5 — the node’s egress follows the machine, and cloud
            backends can be switched off entirely.
          </p>
          <div class="hero__actions">
            <a class="btn btn--ghost" href="https://github.com/wckdboy/invincible/blob/main/spec/routing.md" rel="noopener">
              Routing spec <span class="btn__arrow">↗</span>
            </a>
            <a class="link" href="#trust">Receipts &amp; audit</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section is-paper" id="trust">
    <div class="shell">
      <SectionHead num="04" label="Trust, checkable">
        <Fragment slot="title">Do not trust the claim.<br /><em>Check the bytes.</em></Fragment>
        <Fragment slot="note">
          Releases are signed with a key the installer pins. Linux builds are rebuilt on another
          machine and must match byte for byte before publishing. Every request gets a receipt, and
          every receipt is chained into the audit log.
        </Fragment>
      </SectionHead>

      <div class="split">
        <div class="split__aside">
          <div class="cards" style="grid-template-columns:1fr">
            <div class="card">
              <span class="card__k">01 · Supply chain</span>
              <h3>Signed checksums</h3>
              <p>SHA256SUMS is signed with the release key pinned in the installer. The archive must match it.</p>
            </div>
            <div class="card">
              <span class="card__k">02 · Reproducible</span>
              <h3>Linux builds match</h3>
              <p>CI builds x86_64 a second time on another machine and refuses to publish unless the bytes are identical.</p>
            </div>
            <div class="card">
              <span class="card__k">03 · Provenance</span>
              <h3>Sigstore attestations</h3>
              <p>Each archive carries a build-provenance attestation, verifiable with the GitHub CLI.</p>
            </div>
            <div class="card">
              <span class="card__k">04 · Receipts</span>
              <h3>What left the node</h3>
              <p>Every completion gets a signed receipt: route, tokens, redactions, and every host reached, with bytes in and out.</p>
            </div>
          </div>
        </div>

        <div class="split__main">
          <Terminal
            title="verify a release by hand"
            command="echo 'invincible-release ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAII/0fXPq1j51BcfGY0Jp9QfPGy6kHVQQ+W282VFPR/Qo' > allowed_signers"
            lines={[
              { kind: 'dim', text: 'ssh-keygen -Y verify -f allowed_signers -I invincible-release \\' },
              { kind: 'dim', text: '  -n invincible-release -s SHA256SUMS.sig < SHA256SUMS' },
              { kind: 'dim', text: 'shasum -a 256 -c SHA256SUMS' },
              { kind: 'ok', text: 'Good "invincible-release" signature for invincible-release' },
            ]}
            copyText={`echo 'invincible-release ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAII/0fXPq1j51BcfGY0Jp9QfPGy6kHVQQ+W282VFPR/Qo' > allowed_signers\nssh-keygen -Y verify -f allowed_signers -I invincible-release -n invincible-release -s SHA256SUMS.sig < SHA256SUMS\nshasum -a 256 -c SHA256SUMS`}
            note={['Key pinned in install.sh', 'Sigstore attestation optional']}
          />

          <div class="split mt-3" style="gap:1.2rem">
            <div class="split__aside" style="grid-column:span 6">
              <div class="inset">
                <span class="eyebrow no-rule">Latest release</span>
                <p class="title-m mt-2" style="font-size:1.8rem">v{v(latest.tag)}</p>
                <div class="kv"><span>Published</span><b>{fmtDate(latest.published)}</b></div>
                <div class="kv"><span>License</span><b>{releases.invincible.license}</b></div>
                <div class="kv"><span>Checksums</span><b>{sums ? 'Signed' : 'Inline'}</b></div>
                <div class="kv"><span>Signature</span><b>{sig ? 'SSH · Ed25519' : '—'}</b></div>
                <div class="kv"><span>Install script</span><b>{install.sha256.slice(0, 12)}…</b></div>
              </div>
            </div>
            <div class="split__main" style="grid-column:span 6">
              <div class="note note--red">
                <b>Early build, stated plainly.</b> Invincible v0.x serves models, routes by policy,
                signs receipts and runs the agent end to end. An independent security review is still
                ahead. Do not treat it as hardened infrastructure yet.
              </div>
              <p class="mono mt-3" style="font-size:9px;line-height:1.9;letter-spacing:.08em;color:var(--muted)">
                INSTALL SCRIPT MIRROR<br />SHA-256 {install.sha256}<br />
                {fmtBytes(install.bytes)} · fetched {fmtDate(install.fetchedAt)}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHead num="05" label="Pairing">
        <Fragment slot="title">One QR code.<br /><em>No account in between.</em></Fragment>
        <Fragment slot="note">
          Invincible is built for Autobot first. The node’s key comes from the QR code; the phone’s
          key is pinned on the node. There are no accounts, no passwords and no third-party relay.
        </Fragment>
      </SectionHead>

      <div class="pair" data-reveal>
        <div class="pair__node">
          <span class="mono">01 · Show</span>
          <b><code style="font-family:var(--mono);font-size:.56em;letter-spacing:0">invincible pair</code></b>
          <span>QR + static public key</span>
        </div>
        <div class="pair__link" aria-hidden="true"></div>
        <div class="pair__node">
          <span class="mono">02 · Scan</span>
          <b>Autobot</b>
          <span>Noise IKpsk1 · keys pinned</span>
        </div>
        <div class="pair__link" aria-hidden="true"></div>
        <div class="pair__node">
          <span class="mono">03 · Own</span>
          <b>My node</b>
          <span>Models · agents · receipts</span>
        </div>
      </div>

      <div class="split mt-4">
        <div class="split__aside">
          <div class="quote quote--small">
            The phone keeps its rules. <em>The node extends its reach.</em>
          </div>
        </div>
        <div class="split__main">
          <ul class="checklist">
            <li><span><b>Live model list</b> — the node appears in Providers as My node, never as an API key.</span></li>
            <li><span><b>Unsigned, unseen</b> — chats are redacted only for cloud; phone → node is owned at both ends.</span></li>
            <li><span><b>Agents on the machine</b> — approval cards arrive on the phone; the conversation lives on the node.</span></li>
            <li><span><b>Recipes that outlive the battery</b> — hand a schedule to the node; results return with signed receipts.</span></li>
            <li><span><b>Revocable</b> — unpair from either side; a phone panic wipe forgets the node.</span></li>
          </ul>
          <div class="hero__actions">
            <a class="btn btn--ghost" href="https://autobot.sh">See Autobot <span class="btn__arrow">↗</span></a>
            <a class="link" href="https://github.com/wckdboy/invincible/blob/main/spec/pairing.md" rel="noopener">Pairing spec</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section is-ink" id="install">
    <div class="shell">
      <SectionHead num="06" label="Install">
        <Fragment slot="title">One script.<br /><em>Gateway and agent.</em></Fragment>
        <Fragment slot="note">
          macOS on Apple silicon, or Linux on x86_64 and arm64 — desktop or VPS. No root. It installs
          both commands to ~/.local/bin, verifies the release, installs llama.cpp if missing, and
          runs the setup questions.
        </Fragment>
      </SectionHead>

      <div class="split" data-tabs>
        <div class="split__main">
          <div class="tabs" role="tablist" aria-label="Install options">
            <button class="tab" role="tab" id="tab-script" aria-controls="panel-script" aria-selected="true" tabindex="0" type="button">One script</button>
            <button class="tab" role="tab" id="tab-source" aria-controls="panel-source" aria-selected="false" tabindex="-1" type="button">From source</button>
            <button class="tab" role="tab" id="tab-binary" aria-controls="panel-binary" aria-selected="false" tabindex="-1" type="button">Binaries</button>
          </div>

          <div class="tabpanel" role="tabpanel" id="panel-script" aria-labelledby="tab-script">
            <Terminal
              title="invincible.sh / install"
              command="curl -fsSL https://invincible.sh/install.sh | sh"
              lines={[
                { kind: 'dim', text: '# then' },
                { kind: 'cmd', text: 'autobot            # chat in the terminal' },
                { kind: 'cmd', text: 'autobot code       # code in this directory' },
                { kind: 'cmd', text: 'autobot run "task" # one task, no questions' },
                { kind: 'cmd', text: 'autobot doctor     # check gateway, model, tools, Telegram' },
              ]}
              copyText="curl -fsSL https://invincible.sh/install.sh | sh"
              note={['No root', 'Pinned release key', 'Falls back to source']}
            />
            <p class="mono mt-3" style="font-size:9px;line-height:1.9;letter-spacing:.09em;color:var(--muted)">
              Mirrored from github.com/wckdboy/invincible · SHA-256 {install.sha256.slice(0, 16)}… ·{' '}
              <a class="link" href="https://raw.githubusercontent.com/wckdboy/invincible/main/install.sh" rel="noopener">upstream ↗</a>
            </p>
          </div>

          <div class="tabpanel" role="tabpanel" id="panel-source" aria-labelledby="tab-source" hidden>
            <Terminal
              title="build from source"
              command="git clone https://github.com/wckdboy/invincible && cd invincible"
              lines={[
                { kind: 'cmd', text: 'cargo run --release -- serve' },
                { kind: 'cmd', text: 'cargo run --release -- token' },
                { kind: 'dim', text: '# Rust from rustup; llama-server on PATH' },
              ]}
              copyText="git clone https://github.com/wckdboy/invincible && cd invincible\ncargo run --release -- serve"
              note={['Rust toolchain', 'llama.cpp', 'No runtime']}
            />
          </div>

          <div class="tabpanel" role="tabpanel" id="panel-binary" aria-labelledby="tab-binary" hidden>
            <div class="inset">
              <span class="eyebrow no-rule">Latest v{v(latest.tag)}</span>
              <p class="section-lede mt-2" style="margin-bottom:1.2rem">
                Static binaries for macOS and Linux. Check them against SHA256SUMS, or use the
                script above, which does it for you.
              </p>
              <div class="release__assets" style="margin-top:0">
                {latest.assets
                  .filter((a) => a.name.endsWith('.tar.gz'))
                  .map((a) => (
                    <a class="asset" href={a.url} rel="noopener">
                      <b><Icon name="download" size={11} /></b>
                      {a.name.replace('invincible-', '').replace('.tar.gz', '')}
                      <span>{fmtBytes(a.size)}</span>
                    </a>
                  ))}
                <a class="asset" href={latest.url} rel="noopener"><b>↗</b> Release notes <span>GitHub</span></a>
              </div>
            </div>
          </div>
        </div>

        <div class="split__aside">
          <div class="aside-rule">
            <h3>What setup asks</h3>
            <ol class="checklist" style="counter-reset:none">
              {setup.map(([name, body], i) => (
                <li>
                  <span><b>{i + 1}. {name}</b> — {body}</span>
                </li>
              ))}
            </ol>
          </div>
          <div class="note mt-3">
            <b>Bring your own hardware.</b> Apple silicon and NVIDIA are the v0 targets. One engine
            (llama.cpp) covers both; MLX and vLLM follow behind the same interface.
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHead num="07" label="Evidence">
        <Fragment slot="title">How close is open<br /><em>to frontier?</em></Fragment>
        <Fragment slot="note">
          Fifty tasks built from the real code of Autobot, Omnie and Nightfall. Every expected answer
          was checked by running the code. No model grades another, so a result is the same however
          often it runs.
        </Fragment>
      </SectionHead>

      <div class="split">
        <div class="split__main">
