{
  "name": "wckd-www",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The public sites for Autobot, Invincible Gateway and Sovware.",
  "scripts": {
    "dev": "SITE_KEY=autobot astro dev",
    "dev:invincible": "SITE_KEY=invincible astro dev",
    "dev:sovware": "SITE_KEY=sovware astro dev",
    "build": "SITE_KEY=${SITE_KEY:-autobot} sh -c 'astro build && node scripts/postbuild.mjs'",
    "build:autobot": "SITE_KEY=autobot sh -c 'astro build && node scripts/postbuild.mjs'",
    "build:invincible": "SITE_KEY=invincible sh -c 'astro build && node scripts/postbuild.mjs'",
    "build:sovware": "SITE_KEY=sovware sh -c 'astro build && node scripts/postbuild.mjs'",
    "build:wckd": "SITE_KEY=wckd sh -c 'astro build && node scripts/postbuild.mjs'",
    "build:omnie": "SITE_KEY=omnie sh -c 'astro build && node scripts/postbuild.mjs'",
    "build:nightfall": "SITE_KEY=nightfall sh -c 'astro build && node scripts/postbuild.mjs'",
    "brand": "python3 brand/gen.py",
    "build:all": "pnpm build:autobot && pnpm build:invincible && pnpm build:sovware && pnpm build:wckd && pnpm build:omnie && pnpm build:nightfall",
    "preview": "astro preview",
    "data": "node scripts/fetch-releases.mjs",
    "projects:data": "node scripts/fetch-public-projects.mjs",
    "projects:check": "node --test scripts/projects.test.mjs && node scripts/check-projects.mjs",
    "projects:browser": "node scripts/projects-browser.mjs",
    "sync:install": "node scripts/sync-install.mjs",
    "og": "node scripts/build-og.mjs",
    "verify:links": "node scripts/check-links.mjs",
    "prepare": "node scripts/fetch-releases.mjs --soft && node scripts/sync-install.mjs",
    "deploy": "sh scripts/deploy.sh",
    "deploy:autobot": "sh scripts/deploy-autobot.sh"
  },
  "dependencies": {
    "astro": "7.4.0"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "sharp": "^0.34.4",
    "wrangler": "^4.151.1"
  },
  "packageManager": "pnpm@12.6.0"
}
